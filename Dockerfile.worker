FROM node:26-alpine AS base

# ===== STAGE DE BUILD =====
FROM base AS builder
WORKDIR /app

COPY package*.json ./
COPY turbo.json ./
COPY .npmrc ./

RUN npm ci

COPY . .

# On ne build pas forcément si le worker n'a pas besoin de TypeScript, mais on peut
# On va copier directement les sources et les build avec tsc si nécessaire.
# Ici on suppose que le worker est en JS/TS et que nous avons un script de build.
RUN npm run build:worker || true

# ===== STAGE DE PRODUCTION =====
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json ./

# Si le worker est un script unique, on ajuste le CMD
CMD ["node", "dist/worker.js"]
