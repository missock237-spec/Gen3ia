# ============================================================
# Gen3ia Staging — Variables d'environnement
# Copier vers .env.staging et adapter
# ============================================================

# === NOM DU PROJET ===
COMPOSE_PROJECT_NAME=gen3ia-staging

# === DOMAINES ===
STAGING_DOMAIN=staging.gen3ia.ai
STAGING_URL=https://staging.gen3ia.ai

# === SÉCURITÉ (OBLIGATOIRE) ===
# Générer avec: openssl rand -hex 32
AUTH_SECRET=changez-moi-en-staging-32-caracteres-minimum
ACME_EMAIL=admin@gen3ia.ai

# === BASE DE DONNÉES ===
POSTGRES_PASSWORD=gen3ia_staging_secret

# === IA PROVIDERS ===
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

# === GRAFANA ===
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_staging

# === SEED ===
SEED_DATABASE=false
