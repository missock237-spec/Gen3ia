# ============================================================
# Gen3ia — .env.production.validated (TEMPLATE ONLY)
# ============================================================
# Ce fichier documente toutes les variables d'environnement
# attendues en production. Aucune vraie valeur ici.
#
# Pour retirer ce fichier du tracking git (recommandé) :
#   git rm --cached .env.production.validated
#   git commit -m "chore: untrack .env.production.validated template"
# ============================================================

# ---------- APPLICATION ----------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_TELEMETRY_DISABLED=1
SEED_DATABASE=false
JWT_MAX_AGE=3600

# ---------- Firebase ----------
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxx
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# ---------- Cache & Vector DB ----------
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

# ---------- IA / LLM ----------
OPENAI_ENABLED=false
OPENAI_API_KEY=sk-...
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=sk-ant-...
GROQ_ENABLED=false
GROQ_API_KEY=gsk-...
HUGGINGFACE_ENABLED=false
HUGGINGFACE_TOKEN=hf_...

# ---------- Paiements Chariow ----------
CHARIOW_ENABLED=false
CHARIOW_API_KEY=your-key
CHARIOW_WEBHOOK_SECRET=your-webhook-secret
CHARIOW_API_URL=https://api.chariow.com/v1

# ---------- Email / SMTP ----------
SMTP_ENABLED=false
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=your-user
SMTP_PASS=your-pass
SMTP_SECURE=false
EMAIL_FROM=noreply@your-domain.com

# ---------- Monitoring ----------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=gen3ia
SENTRY_PROJECT=gen3ia-web
LOKI_URL=http://localhost:3100

# ---------- Rate limiting ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Sécurité ----------
VAULT_MASTER_KEY=generate-with-openssl-rand-hex-32
SNYK_TOKEN=
ADMIN_EMAILS=admin@your-domain.com
INTERNAL_SERVICE_SECRET=generate-with-openssl-rand-hex-32
CRON_SECRET=generate-with-openssl-rand-hex-32
