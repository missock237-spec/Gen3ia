# ============================================================
# Gen3ia — .env.production.validated
# Généré pour être le miroir exact de src/lib/env-validation.ts
#
# Légende :
#   [REQUIS]  → variable critique, absences interrompent le démarrage en prod
#   [option+c] → requise UNIQUEMENT si l'intégration est activée (X_ENABLED=true)
#   [option]  → optionnelle, défaut sûr si absente
#   [public]  → exposée au navigateur (prefixe NEXT_PUBLIC_)
#
# NE JAMAIS commiter de vrais secrets ici. Remplir dans .env.production.local.
# ============================================================

# ---------- CRITIQUES ----------
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASS@HOST:5432/DB      # [REQUIS]
AUTH_SECRET=chaine_aleatoire_64_hex                     # [REQUIS] >= 32 caractères en prod
NEXTAUTH_SECRET=${AUTH_SECRET}                          # [option] alias de AUTH_SECRET
NEXTAUTH_URL=https://votre-domaine.example             # [option]
NEXT_PUBLIC_APP_URL=https://votre-domaine.example      # [public] [option] defaut http://localhost:3000

# ---------- Cache & Vector DB ----------
REDIS_URL=redis://localhost:6379                        # [option] requis si rate-limiting/queue
QDRANT_URL=http://localhost:6333                        # [option]

# ---------- IA / LLM (toutes serveur uniquement, pas NEXT_PUBLIC_) ----------
OPENAI_ENABLED=false    # passez a true et fournissez OPENAI_API_KEY
OPENAI_API_KEY=sk-...
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=sk-ant-...
GROQ_ENABLED=false
GROQ_API_KEY=gsk-...
HUGGINGFACE_ENABLED=false
HUGGINGFACE_TOKEN=hf_...

# ---------- Paiements Stripe ----------
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=${STRIPE_PUBLISHABLE_KEY}  # [public]
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PRICE_ID=price_...                         # [public]

# ---------- SebPay (Mobile Money Afrique) ----------
SEBPAY_ENABLED=false
SEBPAY_API_KEY=...
SEBPAY_API_SECRET=...
SEBPAY_BASE_URL=https://api.sebpay.com
SEBPAY_WEBHOOK_SECRET=...

# ---------- Email / SMTP ----------
SMTP_ENABLED=false
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=...
SMTP_PASS=...
SMTP_SECURE=false
EMAIL_FROM=noreply@gen3ia.ai

# ---------- OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Monitoring ----------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=${SENTRY_DSN}   # [public]
SENTRY_ORG=gen3ia
SENTRY_PROJECT=gen3ia-web
LOKI_URL=http://localhost:3100

# ---------- Rate limiting distribué ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Chiffrement & sécurité ----------
VAULT_MASTER_KEY=hex_64_caracteres
SNYK_TOKEN=
ADMIN_EMAILS=admin@gen3ia.ai   # liste separee par des virgules

# ---------- Application ----------
NEXT_TELEMETRY_DISABLED=1
SEED_DATABASE=false
JWT_MAX_AGE=3600
