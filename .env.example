# =============================================
# Genova SaaS - Production-safe Environment Template
# =============================================

# Database
DATABASE_URL=postgresql://genova:change_me@localhost:5432/genova
GENOVA_DATABASE_URL=
POSTGRES_USER=genova
POSTGRES_PASSWORD=change_me
POSTGRES_DB=genova

# Redis
REDIS_URL=redis://localhost:6379

# AI Providers
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
REPLICATE_API_TOKEN=

# Vault / Secret Manager
VAULT_MASTER_KEY=

# Auth Security
AUTH_SALT=
JWT_SECRET=
SESSION_SECRET=

# Email
RESEND_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# WhatsApp Cloud API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# GPU Server Endpoints
COMFYUI_API_URL=http://gpu-server:8188
SPEECHBRAIN_API_URL=http://gpu-server:8187
VIDEO_API_URL=http://gpu-server:8189

# Orchestration / Internal Services
RUFLO_MCP_URL=http://localhost:8190
POCKETBASE_URL=http://localhost:8090
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=
N8N_API_URL=http://localhost:5678
N8N_API_KEY=
BAILEYS_API_URL=http://localhost:8186

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
VECTOR_STORE_TYPE=qdrant

# Monitoring
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=genova-backend
OTEL_TRACING_ENABLED=false
ALERT_WEBHOOK_URL=

# AI Security Limits
MAX_IMAGES_PER_HOUR=10
MAX_VIDEOS_PER_HOUR=5
MAX_AI_CHAT_PER_MINUTE=60
MAX_AI_CODE_PER_MINUTE=30
MAX_FILE_UPLOAD_SIZE_MB=50

# App Settings
NEXT_PUBLIC_APP_URL=https://app.example.com
NODE_ENV=production
CORS_ALLOWED_ORIGINS=https://app.example.com
TRUST_PROXY=true
LOG_LEVEL=warn

# Cookies
COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# Caddy / Public App
APP_DOMAIN=app.example.com
APP_UPSTREAM=localhost:3000
ACME_EMAIL=ops@example.com

# n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me
N8N_HOST=n8n.example.com
N8N_WEBHOOK_URL=https://n8n.example.com/

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# Image Tags
POSTGRES_IMAGE_TAG=16-alpine
REDIS_IMAGE_TAG=7-alpine
QDRANT_IMAGE_TAG=1.9.5
POCKETBASE_IMAGE_TAG=latest
N8N_IMAGE_TAG=latest
PROMETHEUS_IMAGE_TAG=latest
GRAFANA_IMAGE_TAG=latest
