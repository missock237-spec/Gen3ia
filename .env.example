# ============================================================
# Gen3ia — Configuration d'environnement (Dev)
# Copier vers .env.local et adapter
# ============================================================

# ============================================================
# FIREBASE (remplace PostgreSQL/Prisma, NextAuth, fichier upload,
# notification engine, analytics custom)
# ============================================================

# --- Variables PUBLIQUES (exposées au navigateur, NEXT_PUBLIC_*) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Variables SERVEUR (Firebase Admin SDK) ---
# Format 1 (recommandé) : JSON complet du compte de service
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# Format 2 : variables séparées
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# ============================================================
# CACHE (Redis pour BullMQ / rate limiting — optionnel)
# ============================================================
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

# ============================================================
# IA / LLM (serveur uniquement — NE PAS exposer avec NEXT_PUBLIC_)
# ============================================================
OPENAI_API_KEY=sk-votre-cle-ici
ANTHROPIC_API_KEY=sk-ant-votre-cle-ici
GROQ_API_KEY=gsk-votre-cle-ici
HUGGINGFACE_TOKEN=hf_votre_token
HUGGINGFACE_API_KEY=${HUGGINGFACE_TOKEN}

# ============================================================
# CHARIOW — Passeur de paiement unique (Mobile Money Afrique + Carte)
# ============================================================
CHARIOW_API_KEY=
CHARIOW_WEBHOOK_SECRET=
CHARIOW_API_URL=https://api.chariow.com/v1
CHARIOW_PRODUCT_DEFAULT=
CHARIOW_PRODUCT_PLAN_FREE=
CHARIOW_PRODUCT_PLAN_STARTER=
CHARIOW_PRODUCT_PLAN_PRO=
CHARIOW_PRODUCT_PLAN_ENTERPRISE=
CHARIOW_PRODUCT_CREDITS_SMALL=
CHARIOW_PRODUCT_CREDITS_MEDIUM=
CHARIOW_PRODUCT_CREDITS_LARGE=
CHARIOW_PRODUCT_CREDITS_XLARGE=

# ============================================================
# EMAIL (serveur uniquement — utilisé par Firebase Auth pour les reset/verify)
# ============================================================
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@gen3ia.ai
SMTP_SECURE=false

# ============================================================
# MONITORING
# ============================================================
SENTRY_DSN=https://xxx@xxx.sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=${SENTRY_DSN}
SENTRY_ORG=gen3ia
SENTRY_PROJECT=gen3ia-web
LOKI_URL=http://localhost:3100

# ============================================================
# RATE LIMITING (serveur uniquement — optionnel, Firebase App Check peut remplacer)
# ============================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# CHIFFREMENT & SECURITE (serveur uniquement)
# ============================================================
VAULT_MASTER_KEY=hex-64-caracteres
SNYK_TOKEN=
ADMIN_EMAILS=admin@gen3ia.ai

# ============================================================
# CSP STRICT (optionnel)
# ============================================================
NEXT_PUBLIC_STRICT_CSP=false

# ============================================================
# APPLICATION
# ============================================================
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
