# =============================================
# Genova AI - Configuration Production
# =============================================

# ██████   DATABASE   ██████
DATABASE_URL=postgresql://genova:change_me@localhost:5432/genova

# ██████   AUTHENTIFICATION   ██████
AUTH_SECRET=<openssl rand -hex 32>
JWT_SECRET=
SESSION_SECRET=
# Emails autorisés à être admin (séparés par des virgules)
ADMIN_EMAILS=admin@genova.ai

# ██████   PAIEMENTS (SebPay Africa)   ██████
SEBPAY_PUBLIC_KEY=
SEBPAY_SECRET_KEY=
SEBPAY_ENVIRONMENT=sandbox
SEBPAY_WEBHOOK_SECRET=

# ██████   EMAIL (Resend)   ██████
RESEND_API_KEY=
EMAIL_FROM=noreply@genova.ai
EMAIL_FROM_NAME=Genova AI

# ██████   WHATSAPP CLOUD API   ██████
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# ██████   OAUTH (Google + GitHub)   ██████
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ██████   AI PROVIDERS   ██████
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ██████   APP   ██████
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
