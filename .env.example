# =============================================
# Genova SaaS - Toutes les variables d'environnement
# =============================================

# Base de données
DATABASE_URL=postgresql://genova:genova_pass@localhost:5432/genova
GENOVA_DATABASE_URL=
POSTGRES_USER=genova
POSTGRES_PASSWORD=genova_pass
POSTGRES_DB=genova

# Redis
REDIS_URL=redis://localhost:6379

# AI Providers (priorité: Groq > Gemini > OpenRouter)
GROQ_API_KEY=
GEMINI_API_KEY=
GOOGLE_GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Image & Vidéo
HUGGINGFACE_API_KEY=
HF_API_KEY=
REPLICATE_API_TOKEN=

# Recherche web
SERPAPI_API_KEY=

# Sécurité
AUTH_SALT=
JWT_SECRET=
SESSION_SECRET=

# Email
RESEND_API_KEY=

# Stripe Paiements
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
STRIPE_CREDITS_100_PRICE_ID=
STRIPE_CREDITS_500_PRICE_ID=
STRIPE_CREDITS_2000_PRICE_ID=
STRIPE_CREDITS_5000_PRICE_ID=

# Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_AD_SLOT=

# WhatsApp
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# Qdrant Vector Store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
VECTOR_STORE_TYPE=qdrant

# Webhooks sortants (Zapier, Make, n8n)
WEBHOOK_GLOBAL_URL=
WEBHOOK_GLOBAL_SECRET=
ZAPIER_WEBHOOK_URL=
MAKE_WEBHOOK_URL=
N8N_WEBHOOK_URL=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=true
LOG_LEVEL=debug
COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Limites
MAX_IMAGES_PER_HOUR=10
MAX_VIDEOS_PER_HOUR=5
MAX_AI_CHAT_PER_MINUTE=60
MAX_AI_CODE_PER_MINUTE=30
MAX_FILE_UPLOAD_SIZE_MB=50

# Docker
POSTGRES_IMAGE_TAG=16-alpine
REDIS_IMAGE_TAG=7-alpine
QDRANT_IMAGE_TAG=latest
POCKETBASE_IMAGE_TAG=latest
PROMETHEUS_IMAGE_TAG=latest
GRAFANA_IMAGE_TAG=latest
