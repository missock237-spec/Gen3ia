# ============================================================
# GENOVA — Variables d'environnement
# ============================================================
# Copiez ce fichier en .env et remplissez les valeurs
# cp .env.example .env
# ============================================================

# === DATABASE ===
# URL de connexion PostgreSQL (Utilisée par Prisma v7 via prisma.config.ts)
DATABASE_URL=postgresql://user:password@localhost:5432/genova

# === AUTH ===
# Clé secrète pour les sessions et tokens JWT
AUTH_SECRET=votre-secret-tres-long-32-caracteres-minimum

# === REDIS (optionnel mais recommandé) ===
# URL Redis pour BullMQ et le rate limiting
REDIS_URL=redis://localhost:6379

# Upstash Redis (alternative cloud pour rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === PAIEMENTS ===
# Provider de paiement (stripe | sebpay | autre)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# === EMAIL ===
# Provider email (resend | nodemailer)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=noreply@genova.ai

# === IA ===
# Provider IA (openai | openrouter | anthropic)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# === STOCKAGE ===
# Provider de stockage (local | s3 | supabase)
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# === APPLICATIONS EXTERNES ===
# WhatsApp (Baileys)
WHATSAPP_SESSION_ID=

# n8n (workflows)
N8N_API_KEY=
N8N_WEBHOOK_URL=

# Pocketbase
POCKETBASE_URL=
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# === MONITORING ===
# Sentry (optionnel)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Better Stack / Logtail (optionnel)
BETTER_STACK_TOKEN=

# === APPLICATION ===
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=debug
