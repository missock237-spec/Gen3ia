# Gen3ia — Fichier d'exemple des variables d'environnement
# Copier vers .env.local pour le développement

# === BASE ===
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === DATABASE ===
DATABASE_URL=postgresql://gen3ia:password@localhost:5432/gen3ia
GEN3IA_DATABASE_URL=

# === AUTH ===
AUTH_SECRET=votre-secret-tres-long-au-moins-32-caracteres
NEXTAUTH_SECRET=${AUTH_SECRET}
NEXTAUTH_URL=http://localhost:3000

# === OAUTH ===
# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# === IA PROVIDERS ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_API_KEY=${OPENAI_API_KEY}
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# === HUGGING FACE (gratuit) ===
HUGGINGFACE_API_KEY=hf_votre_token
HUGGINGFACE_TOKEN=${HUGGINGFACE_API_KEY}
NEXT_PUBLIC_HUGGINGFACE_API_KEY=${HUGGINGFACE_API_KEY}

# === REDIS ===
REDIS_URL=redis://localhost:6379

# === WHATSAPP ===
WHATSAPP_VERIFY_TOKEN=gen3ia_whatsapp_verify

# === SENTRY ===
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# === PAIEMENT SEBPAY (remplace Stripe) ===
# SebPay — Paiement Mobile Money Afrique (Orange Money, MTN MoMo, Wave, Carte Bancaire)
SEBPAY_API_KEY=
SEBPAY_API_SECRET=
SEBPAY_BASE_URL=https://api.sebpay.africa/v1
SEBPAY_WEBHOOK_SECRET=
SEBPAY_STARTER_PLAN_ID=plan_starter
SEBPAY_PRO_PLAN_ID=plan_pro
SEBPAY_ENTERPRISE_PLAN_ID=plan_enterprise
SEBPAY_CREDITS_100_PLAN_ID=plan_credits_100
SEBPAY_CREDITS_500_PLAN_ID=plan_credits_500
SEBPAY_CREDITS_2000_PLAN_ID=plan_credits_2000
SEBPAY_CREDITS_5000_PLAN_ID=plan_credits_5000

# === N8N ===
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=

# === VAULT ===
VAULT_MASTER_KEY=
MCP_ENCRYPTION_KEY=${AUTH_SECRET}

# === MONITORING ===
HEAP_THRESHOLD_MB=500
