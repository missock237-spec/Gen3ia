# ============================================================
# Gen3ia — Configuration d'environnement
# Copier vers .env.local et adapter
# ============================================================

# === Base de donnees et Cache ===
DATABASE_URL=postgresql://gen3ia:gen3ia_dev@localhost:5432/gen3ia_dev
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

# === Authentification ===
AUTH_SECRET=dev-secret-key-32-caracteres-minimum!!
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_MAX_AGE=3600

# === IA / LLM ===
OPENAI_API_KEY=sk-votre-cle-ici
ANTHROPIC_API_KEY=sk-ant-votre-cle-ici
HUGGINGFACE_TOKEN=hf_votre_token

# === Stripe (optionnel) ===
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_
NEXT_PUBLIC_STRIPE_PRICE_ID=price_

# === SebPay (Mobile Money Afrique) ===
SEBPAY_API_KEY=
SEBPAY_API_SECRET=
SEBPAY_BASE_URL=https://api.sebpay.com
SEBPAY_WEBHOOK_SECRET=

# === Email (Nodemailer / Resend) ===
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@gen3ia.ai
SMTP_SECURE=false

# === Auth OAuth (optionnel) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# === Monitoring & Logs ===
SENTRY_DSN=https://xxx@xxx.sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.sentry.io/xxx
SENTRY_ORG=gen3ia
SENTRY_PROJECT=gen3ia-web
LOKI_URL=http://localhost:3100

# === Rate Limiting (Upstash) ===
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Deploiement Render ===
RENDER_DEPLOY_HOOK_URL=

# === Sentry & Securite ===
SNYK_TOKEN=
ADMIN_EMAILS=admin@gen3ia.ai

# === Application ===
NODE_ENV=development
SEED_DATABASE=false