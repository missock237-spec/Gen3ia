# ============================================================
# Gen3ia — Configuration d'environnement (Dev)
# Copier vers .env.local et adapter
# ============================================================

# ============================================================
# BASE DE DONNEES & CACHE (serveur uniquement)
# ============================================================
DATABASE_URL=postgresql://gen3ia:gen3ia_dev@localhost:5432/gen3ia_dev
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

# ============================================================
# AUTHENTIFICATION (serveur uniquement)
# ============================================================
AUTH_SECRET=dev-secret-key-32-caracteres-minimum!!
NEXTAUTH_SECRET=${AUTH_SECRET}
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_MAX_AGE=3600

# ============================================================
# IA / LLM (serveur uniquement — NE PAS exposer avec NEXT_PUBLIC_)
# ============================================================
OPENAI_API_KEY=sk-votre-cle-ici
ANTHROPIC_API_KEY=sk-ant-votre-cle-ici
GROQ_API_KEY=gsk-votre-cle-ici

# Hugging Face — utilisez un proxy API route cote serveur
# NE PAS creer de variable NEXT_PUBLIC_HUGGINGFACE_API_KEY
# Les tokens Hugging Face sont secrets et seraient exposes au navigateur
HUGGINGFACE_TOKEN=hf_votre_token
HUGGINGFACE_API_KEY=${HUGGINGFACE_TOKEN}

# ============================================================
# STRIPE (paiement par carte)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY est publique par conception
# ============================================================
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=${STRIPE_PUBLISHABLE_KEY}
STRIPE_WEBHOOK_SECRET=whsec_
NEXT_PUBLIC_STRIPE_PRICE_ID=price_

# ============================================================
# SEBPAY — Mobile Money Afrique (serveur uniquement)
# ============================================================
SEBPAY_API_KEY=
SEBPAY_API_SECRET=
SEBPAY_BASE_URL=https://api.sebpay.com
SEBPAY_WEBHOOK_SECRET=

# ============================================================
# EMAIL (serveur uniquement)
# ============================================================
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@gen3ia.ai
SMTP_SECURE=false

# ============================================================
# OAUTH (serveur uniquement)
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================================
# MONITORING
# NEXT_PUBLIC_SENTRY_DSN est publique par conception
# ============================================================
SENTRY_DSN=https://xxx@xxx.sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=${SENTRY_DSN}
SENTRY_ORG=gen3ia
SENTRY_PROJECT=gen3ia-web
LOKI_URL=http://localhost:3100

# ============================================================
# RATE LIMITING (serveur uniquement)
# ============================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# CHIFFREMENT & SECURITE (serveur uniquement)
# ============================================================
VAULT_MASTER_KEY=hex-64-caracteres
SNYK_TOKEN=
ADMIN_EMAILS=admin@gen3ia.ai

# ============================================================
# APPLICATION
# ============================================================
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
SEED_DATABASE=false
