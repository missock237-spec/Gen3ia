# Database
DATABASE_URL=postgresql://genova:change_me@localhost:5432/genova

# 💳 SebPay Africa - Paiements Mobile Money
# Obtenez vos clés sur https://sebpay.africa/account/api
# Sandbox (test) : https://sandbox-api.sebpay.africa/v1
# Production     : https://api.sebpay.africa/v1
SEBPAY_PUBLIC_KEY=
SEBPAY_SECRET_KEY=
SEBPAY_ENVIRONMENT=sandbox
SEBPAY_WEBHOOK_SECRET=

# AI Providers
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Auth Security
AUTH_SALT=
JWT_SECRET=
SESSION_SECRET=

# Resend (Email)
RESEND_API_KEY=

# WhatsApp Cloud API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# App Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000
