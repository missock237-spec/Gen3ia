# ============================================================
# GEN3IA — Configuration
# Copiez ce fichier en .env et remplissez vos clés.
# AUCUNE clé n'est écrite en dur dans le code ; le frontend
# n'accède jamais aux secrets serveur.
# ============================================================

# --- Base de données (Prisma) ---
# SQLite local (développement) :
DATABASE_URL="file:./db/custom.db"
# Production serverless (Vercel) : utilisez Postgres (Neon, Supabase…) :
# DATABASE_URL="postgresql://user:password@host:5432/gen3ia?sslmode=require"
# Le dialecte Prisma est sélectionné AUTOMATIQUEMENT au build selon ce préfixe,
# et le schéma est créé automatiquement à la première requête (zéro migration
# manuelle). Sans Postgres en production, SQLite fonctionne mais chaque
# fonction serverless a sa base propre (données non partagées) : la persistance
# complète exige donc une URL Postgres.

# --- URL publique de l'application (endpoints d'agents, callbacks Chariow) ---
APP_URL="http://localhost:3000"

# --- Moteurs LLM (au moins un requis pour l'inférence) ---
# GLM via Zhipu BigModel (moteur principal recommandé)
GLM_API_KEY=""
# OpenRouter (accès multi-modèles : GLM, GPT, Claude, Llama…)
OPENROUTER_API_KEY=""
# Groq (inférence ultra-rapide)
GROQ_API_KEY=""
# OpenAI
OPENAI_API_KEY=""
# HuggingFace (router d'inférence)
HUGGINGFACE_API_KEY=""

# --- Paiements Chariow ( UNIQUE processeur autorisé ) ---
CHARIOW_API_KEY=""
# Point d'entrée de l'API Chariow (à ajuster selon votre compte)
CHARIOW_BASE_URL="https://api.chariow.io/v1"
# Secret partagé pour vérifier la signature HMAC-SHA256 du webhook
CHARIOW_WEBHOOK_SECRET=""

# --- Administration (optionnel) ---
# Liste d'e-mails séparés par des virgules promus ADMIN à l'inscription.
# Sur un déploiement vierge, le PREMIER compte créé devient ADMIN.
ADMIN_EMAILS=""

# --- Sessions ---
# Généré automatiquement si absent ( déploiements ) :
SESSION_SECRET=""

# ============================================================
# v3.1 — Améliorations : vecteurs, cache, observabilité, fiabilité
# ============================================================

# --- Embeddings (RAG sémantique) ---
# auto (défaut) : fournisseur openai-compatible si OPENAI_API_KEY présent,
# sinon repli local (hachage n-grammes, sans clé, sans réseau).
EMBEDDINGS_PROVIDER="auto"
# Clé dédiée aux embeddings (défaut : OPENAI_API_KEY)
EMBEDDING_API_KEY=""
# Point d'entrée compatible OpenAI /v1 (défaut : https://api.openai.com/v1)
EMBEDDINGS_BASE_URL=""
# Modèle d'embedding (défaut : text-embedding-3-small)
EMBEDDINGS_MODEL="text-embedding-3-small"
# Dimension (défaut : 512 — coût/rappel équilibré)
EMBEDDINGS_DIM="512"

# --- Cache de plans (plans fréquents) ---
# on (défaut) | off — désactive entièrement le cache
PLAN_CACHE="on"
# Durée de vie des entrées en jours (défaut : 7)
PLAN_CACHE_TTL_DAYS="7"

# --- Observabilité ---
# debug | info | warn | error (défaut : debug en dev, info en production)
LOG_LEVEL=""
# Fenêtre d'agrégation des statistiques de moteurs, en jours (défaut : 7)
METRICS_WINDOW_DAYS="7"

# --- Fiabilité (circuit breaker) ---
# Plafond GLOBAL de retries par tâche, toutes stratégies confondues (défaut : 8)
MAX_TOTAL_RETRIES="8"

# ============================================================
# v3.3 — Connecteurs d'applications (moteur LOCAL, ADR-0014)
# ============================================================
# 13 apps réelles intégrées au code (GitHub, Slack, Gmail, Calendar,
# Notion, Discord, Trello, Jira, Linear, Airtable, Telegram, Stripe, X).
# L'import de token utilisateur (PAT, bot, clé API) fonctionne SANS
# aucune variable. Les flux OAuth ci-dessous sont optionnels.

# Clé de chiffrement dédiée des secrets de connexion (hex, 32 octets).
# Générer : openssl rand -hex 32. Sans elle : clé dérivée de SESSION_SECRET.
CONNECTORS_ENCRYPTION_KEY=""

# --- Flux OAuth2 (optionnels) ---
# GitHub OAuth App : https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Slack App : https://api.slack.com/apps
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
# Google Cloud OAuth (Gmail + Calendar) : console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# --- Flux OAuth1 (optionnel) ---
# Trello Power-Up : trello.com/power-ups/admin
TRELLO_CONSUMER_KEY=""
TRELLO_CONSUMER_SECRET=""
# --- Flux OAuth2 PKCE (optionnel) ---
# X Developer Portal : developer.x.com
X_CLIENT_ID=""
X_CLIENT_SECRET=""
