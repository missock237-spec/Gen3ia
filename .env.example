# =============================================
# Genova AI - Configuration Production
# =============================================

# ██████   DATABASE   ██████
DATABASE_URL=postgresql://genova:change_me@localhost:5432/genova

# ██████   REDIS   ██████
REDIS_URL=redis://localhost:6379

# ██████   AUTHENTIFICATION   ██████
AUTH_SECRET=<openssl rand -hex 32>
JWT_SECRET=
SESSION_SECRET=
ADMIN_EMAILS=admin@genova.ai

# ██████   PAIEMENTS (SebPay Africa - Mobile Money)   ██████
# SebPay permet les paiements Orange Money, MTN, Airtel, Moov dans 15 pays africains
SEBPAY_API_KEY=votre_cle_api
SEBPAY_API_SECRET=votre_cle_secrete
SEBPAY_BASE_URL=https://api.sebpay.africa/v1
SEBPAY_WEBHOOK_SECRET=secret_webhook
# Mode sandbox pour les tests
# SEBPAY_BASE_URL=https://sandbox.sebpay.africa/v1

# ██████   EMAIL (Resend)   ██████
RESEND_API_KEY=
EMAIL_FROM=noreply@genova.ai
EMAIL_FROM_NAME=Genova AI

# ██████   WHATSAPP CLOUD API   ██████
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# ██████   OAUTH (Google + GitHub)   ██████
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ██████   AI PROVIDERS   ██████
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ██████   STRIPE (Fallback paiement international)   ██████
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ██████   MONITORING   ██████
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ██████   APP   ██████
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
