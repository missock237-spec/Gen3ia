# Genova AI — Variables d'environnement v0.8.1

# Base de donnees
DATABASE_URL="postgresql://user:password@localhost:5432/genova"

# Authentification
AUTH_SECRET="votre-secret-32-caracteres-minimum!!"
NEXTAUTH_SECRET="votre-nextauth-secret-32-caracteres-minimum!"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# IA Relay System: Groq -> OpenRouter -> OpenAI -> Anthropic
GROQ_API_KEY="gsk_..."
OPENROUTER_API_KEY="sk-or-..."
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."

# HuggingFace: generation gratuite (TTS, image, video, audio)
HUGGINGFACE_TOKEN="hf_..."

# Voice TTS payant fallback
ELEVENLABS_API_KEY="..."

# Recherche web temps reel
SERPAPI_API_KEY="..."

# Telephonie
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+237XXXXXXXXX"

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Monitoring
SENTRY_DSN="https://...@ingest.sentry.io/..."
SENTRY_ENVIRONMENT="development"

# Redis
REDIS_URL="redis://localhost:6379"

# n8n
N8N_BASE_URL="http://localhost:5678"
N8N_API_KEY="..."

# Chiffrement
VAULT_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Resend emails
RESEND_API_KEY="re_..."

# WhatsApp
WHATSAPP_PHONE_NUMBER_ID="..."
WHATSAPP_API_TOKEN="..."

# Deepgram STT
DEEPGRAM_API_KEY="..."

# Compute Engine
COMPUTE_BACKEND="auto"
MAX_WORKERS=4

# Feature Flags
ENABLE_ADVERTISING=true
ENABLE_VOICE_AGENT=true
ENABLE_ADAPTIVE_ROUTING=true

# NODE_ENV
NODE_ENV="development"