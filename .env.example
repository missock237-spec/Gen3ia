# ============================================================
# Genova AI — Fichier d'exemple des variables d'environnement
# Copiez ce fichier en .env et remplissez vos valeurs
# ============================================================

# ── Base de données ───────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/genova?schema=public"
GENOVA_DATABASE_URL="${DATABASE_URL}"

# ── Authentification NextAuth ────────────────────────────────
AUTH_SECRET="votre-secret-32-caracteres-minimum"
NEXTAUTH_URL="http://localhost:3000"

# ── URL publique (pour les webhooks Twilio, n8n) ────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
GENOVA_API_URL="${NEXT_PUBLIC_APP_URL}"

# ── Fournisseurs LLM (au moins un requis) ────────────────────
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GROQ_API_KEY="gsk_..."
OPENROUTER_API_KEY="sk-or-..."
HUGGINGFACE_API_KEY="hf_..."

# ── Téléphonie (Twilio) ──────────────────────────────────────
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+14155551234"

# ── n8n (automatisation connecteurs) ─────────────────────────
N8N_BASE_URL="http://localhost:5678"
N8N_API_KEY="..."

# ── Chiffrement des secrets utilisateur (VAULT) ─────────────
# Générer avec : openssl rand -hex 32
VAULT_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ── Stripe (paiements / abonnements) ─────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Resend (emails transactionnels) ──────────────────────────
RESEND_API_KEY="re_..."

# ── Vercel (déploiement) ────────────────────────────────────
VERCEL_TOKEN="..."
VERCEL_ORG_ID="..."
VERCEL_PROJECT_ID="..."

# ── Cookies ──────────────────────────────────────────────────
COOKIE_SECURE="true"
SESSION_COOKIE_SAMESITE="lax"

# ── Deepgram (STT - reconnaissance vocale) ───────────────────
DEEPGRAM_API_KEY="..."

# ── ElevenLabs (TTS - synthèse vocale) ───────────────────────
ELEVENLABS_API_KEY="..."

# ── Google OAuth (connexion sociale) ─────────────────────────
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."

# ── GitHub OAuth ─────────────────────────────────────────────
GITHUB_CLIENT_ID="..."
GITHUB_CLIENT_SECRET="..."

# ── NODE_ENV ────────────────────────────────────────────────
NODE_ENV="development"
