# Gen3ia — Fichier d'exemple des variables d'environnement
# Copier vers .env.local pour le développement

# === BASE ===
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === DATABASE ===
DATABASE_URL=postgresql://gen3ia:password@localhost:5432/gen3ia
GEN3IA_DATABASE_URL=

# === AUTH ===
AUTH_SECRET=votre-secret-tres-long-au-moins-32-caracteres
NEXTAUTH_SECRET=${AUTH_SECRET}
NEXTAUTH_URL=http://localhost:3000

# === OAUTH ===
# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# === IA PROVIDERS ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_API_KEY=${OPENAI_API_KEY}
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# === HUGGING FACE (gratuit) ===
HUGGINGFACE_API_KEY=hf_votre_token
HUGGINGFACE_TOKEN=${HUGGINGFACE_API_KEY}
NEXT_PUBLIC_HUGGINGFACE_API_KEY=${HUGGINGFACE_API_KEY}

# === REDIS ===
REDIS_URL=redis://localhost:6379

# === WHATSAPP ===
WHATSAPP_VERIFY_TOKEN=gen3ia_whatsapp_verify

# === SENTRY ===
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# === PAIEMENT ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# === N8N ===
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=

# === VAULT ===
VAULT_MASTER_KEY=
MCP_ENCRYPTION_KEY=${AUTH_SECRET}

# === MONITORING ===
HEAP_THRESHOLD_MB=500
