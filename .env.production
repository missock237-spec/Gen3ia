# ============================================================
# GEN3IA — Production Environment Variables (Firebase-only)
# SECURITY: CE FICHIER NE DOIT JAMAIS CONTENIR DE VRAIS SECRETS.
# Copiez ce fichier en .env.production.local (ignore par git) et
# remplissez VOS propres valeurs la. Rotation des cles recommandee.
# ============================================================

# ============================================================
# FIREBASE (remplace PostgreSQL/Prisma, NextAuth, upload, analytics)
# ============================================================
FIREBASE_PROJECT_ID="placeholder_a_remplacer"
FIREBASE_CLIENT_EMAIL="placeholder_a_remplacer"
FIREBASE_PRIVATE_KEY="placeholder_a_remplacer"
NEXT_PUBLIC_FIREBASE_API_KEY="placeholder_a_remplacer"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="placeholder_a_remplacer"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="placeholder_a_remplacer"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="placeholder_a_remplacer"
NEXT_PUBLIC_FIREBASE_APP_ID="placeholder_a_remplacer"
NEXT_PUBLIC_FIREBASE_DATABASE_URL="placeholder_a_remplacer"

# ============================================================
# APPLICATION / CACHE
# ============================================================
NEXT_PUBLIC_APP_URL="https://votre-domaine.example"
REDIS_URL="placeholder_a_remplacer"

# ============================================================
# IA / LLM
# ============================================================
OPENAI_API_KEY="placeholder_a_remplacer"
ANTHROPIC_API_KEY="placeholder_a_remplacer"
GROQ_API_KEY="placeholder_a_remplacer"
HUGGINGFACE_TOKEN="placeholder_a_remplacer"

# ============================================================
# PAIEMENTS CHARIOW
# ============================================================
CHARIOW_API_KEY="placeholder_a_remplacer"
CHARIOW_WEBHOOK_SECRET="placeholder_a_remplacer"
CHARIOW_API_URL="https://api.chariow.com/v1"

# ============================================================
# EMAIL
# ============================================================
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER="placeholder_a_remplacer"
SMTP_PASS="placeholder_a_remplacer"
EMAIL_FROM="noreply@votre-domaine.example"
SMTP_SECURE=false

# ============================================================
# MONITORING
# ============================================================
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN="${SENTRY_DSN}"
SENTRY_ORG="gen3ia"
SENTRY_PROJECT="gen3ia-web"

# ============================================================
# CHIFFREMENT & SECURITE
# ============================================================
VAULT_MASTER_KEY="placeholder_64_hex_a_remplacer"
ADMIN_EMAILS="admin@votre-domaine.example"

# SECRETS INTERNES / CRON (64 hex aleatoires — openssl rand -hex 32)
INTERNAL_SERVICE_SECRET="placeholder_64_hex_a_remplacer"
CRON_SECRET="placeholder_64_hex_a_remplacer"

# ============================================================
# APPLICATION
# ============================================================
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
SEED_DATABASE=false
