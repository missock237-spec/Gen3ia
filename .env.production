# ============================================================
# Gen3ia — .env.production (TEMPLATE ONLY — NO REAL SECRETS)
# ============================================================
# CE FICHIER EST UN MODELE. Il ne doit JAMAIS contenir de vrais secrets.
#
# Instructions :
#   1. Copiez ce fichier en .env.production.local
#   2. Remplissez vos vraies valeurs dans .env.production.local
#   3. .env.production.local est ignoré par git (voir .gitignore)
#
# Pour retirer ce fichier du tracking git (recommandé) :
#   git rm --cached .env.production
#   git commit -m "chore: untrack .env.production template"
# ============================================================

# --- Firebase ---
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:xxxx"
NEXT_PUBLIC_FIREBASE_DATABASE_URL="https://your-project-default-rtdb.firebaseio.com"

# --- Application ---
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# --- Cache ---
REDIS_URL="redis://localhost:6379"

# --- IA / LLM (serveur uniquement) ---
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GROQ_API_KEY="gsk-..."
HUGGINGFACE_TOKEN="hf_..."

# --- Paiements Chariow ---
CHARIOW_API_KEY="your-chariow-api-key"
CHARIOW_WEBHOOK_SECRET="your-webhook-secret"
CHARIOW_API_URL="https://api.chariow.com/v1"

# --- Email (production) ---
# Méthode recommandée : clé API Resend (priorité sur SMTP)
RESEND_API_KEY="re_votre_cle_resend"
EMAIL_FROM="noreply@gen3ia.online"
EMAIL_FROM_NAME="Gen3ia"

# Fallback SMTP (si RESEND_API_KEY n'est pas défini)
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER="resend"
SMTP_PASS="your-smtp-password"
SMTP_FROM_EMAIL="noreply@gen3ia.online"
SMTP_FROM_NAME="Gen3ia"
SMTP_SECURE=false

# --- Monitoring ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG="gen3ia"
SENTRY_PROJECT="gen3ia-web"

# --- Sécurité ---
VAULT_MASTER_KEY="generate-with-openssl-rand-hex-32"
ADMIN_EMAILS="admin@your-domain.com"
INTERNAL_SERVICE_SECRET="generate-with-openssl-rand-hex-32"
CRON_SECRET="generate-with-openssl-rand-hex-32"
