# ============================================================
# GEN3IA — Production Environment Variables
# Deploiement: Vercel / Docker / VPS
# ============================================================

# ============================================================
# BASE DE DONNEES & CACHE
# ============================================================
DATABASE_URL="postgresql://user:password@host:5432/gen3ia"
REDIS_URL="redis://host:6379"
QDRANT_URL="http://host:6333"

# ============================================================
# AUTHENTIFICATION (NextAuth.js)
# ============================================================
AUTH_SECRET="generer-avec-openssl-rand-64-hex"
NEXTAUTH_SECRET="${AUTH_SECRET}"
NEXTAUTH_URL="https://gen3ia.vercel.app"
NEXT_PUBLIC_APP_URL="https://gen3ia.vercel.app"
JWT_MAX_AGE=3600

# ============================================================
# IA / LLM — Fournisseurs
# ============================================================
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GROQ_API_KEY="gsk-..."
HUGGINGFACE_TOKEN="hf_..."
HUGGINGFACE_API_KEY="${HUGGINGFACE_TOKEN}"
HUGGINGFACE_API_KEY="${HUGGINGFACE_TOKEN}"

# ============================================================
# OAUTH — Google & GitHub
# ============================================================
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."
GITHUB_CLIENT_ID="..."
GITHUB_CLIENT_SECRET="..."

# ============================================================
# STRIPE
# ============================================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PRICE_ID="price_..."

# ============================================================
# SEBPAY — Mobile Money Afrique
# ============================================================
SEBPAY_API_KEY="..."
SEBPAY_API_SECRET="..."
SEBPAY_BASE_URL="https://api.sebpay.com"
SEBPAY_WEBHOOK_SECRET="..."

# ============================================================
# EMAIL
# ============================================================
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER="..."
SMTP_PASS="..."
EMAIL_FROM="noreply@gen3ia.ai"
SMTP_SECURE=false

# ============================================================
# MONITORING & LOGS
# ============================================================
SENTRY_DSN="https://xxx@xxx.sentry.io/xxx"
NEXT_PUBLIC_SENTRY_DSN="${SENTRY_DSN}"
SENTRY_ORG="gen3ia"
SENTRY_PROJECT="gen3ia-web"
LOKI_URL="http://host:3100"

# ============================================================
# RATE LIMITING
# ============================================================
UPSTASH_REDIS_REST_URL="..."
UPSTASH_REDIS_REST_TOKEN="..."

# ============================================================
# CHIFFREMENT & SECURITE
# ============================================================
VAULT_MASTER_KEY="hex-64-caracteres"
ADMIN_EMAILS="admin@gen3ia.ai"

# ============================================================
# APPLICATION
# ============================================================
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
SEED_DATABASE=false
