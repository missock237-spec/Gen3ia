# ============================================================
# GEN3IA — Production Environment Variables
# Déploiement: Render (https://render.com)
# ============================================================

# Base de donnees (Neon/Supabase/RDS)
DATABASE_URL="postgresql://user:password@host:5432/gen3ia"

# Redis (Render Redis ou Redis Cloud)
REDIS_URL="redis://host:6379"

# Authentification
AUTH_SECRET="generer-avec-openssl-rand-64-hex"
NEXTAUTH_SECRET="${AUTH_SECRET}"

# URL publique (sera automatique sur Render)
NEXT_PUBLIC_APP_URL="https://gen3ia-app.onrender.com"

# Fournisseurs LLM
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GROQ_API_KEY="gsk-..."

# Hugging Face (gratuit)
HUGGINGFACE_API_KEY="hf_..."
NEXT_PUBLIC_HUGGINGFACE_API_KEY="${HUGGINGFACE_API_KEY}"

# OAuth Google
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."

# OAuth GitHub
GITHUB_CLIENT_ID="..."
GITHUB_CLIENT_SECRET="..."

# Chiffrement
VAULT_MASTER_KEY="hex-64-caracteres"

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Sentry
SENTRY_DSN="..."
