# ============================================================
# GEN3IA — Production Environment Variables
# Copier vers .env avant le déploiement
# ============================================================

# Base de donnees (Neon/Supabase/RDS)
DATABASE_URL="postgresql://user:password@host:5432/gen3ia"

# Authentification
AUTH_SECRET="generer-avec-openssl-rand-64-hex"

# URL publique
NEXT_PUBLIC_APP_URL="https://gen3ia.app"

# Fournisseurs LLM
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GROQ_API_KEY="gsk-..."

# Chiffrement
VAULT_MASTER_KEY="hex-64-caracteres"

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# n8n
N8N_ENCRYPTION_KEY="cle-chiffrement-n8n"
