    "@sentry/nextjs": "^8",
    "@tanstack/react-query": "^5.82.0",
    "eslint": "^9",
    "eslint-config-next": "14.2.29",
    "tailwindcss": "^4",
    "vitest": "^3.1.3",
    "stripe": "^17.6.0",
    "zod": "^4.0.2",
    "zustand": "^5.0.6",
