{
  "name": "genova-ai",
  "version": "2.0.0",
  "private": true,
  "description": "Genova AI Agent Operating System - SaaS Platform",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "NODE_ENV=production node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
