{
  "name": "gen3ia",
  "version": "0.10.0",
  "private": true,
  "packageManager": "npm@10.8.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "next build && turbo run build",
    "build:root": "next build",
    "build:packages": "turbo run build",
    "start": "next start",
    "test": "turbo run test",
    "test:unit": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "build:worker": "tsc --project tsconfig.worker.json && tsc-alias --project tsconfig.worker.json",
    "postinstall": "node -e \"try { require('child_process').execSync('npx prisma generate', { stdio: 'inherit' }) } catch(e) { console.log('Prisma generate skipped (not critical)') }\"",
    "lint": "turbo run lint",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "clean": "turbo run clean && rm -rf .next coverage node_modules dist"
  },
  "overrides": {
    "next": "14.2.29",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "next-auth": "^4.24.13",
