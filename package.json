  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "prettier": "^3.6.2",
    "prisma": "^6.11.1",
    "tailwindcss": "^4",
    "@tailwindcss/postcss": "^4",
    "vitest": "^3.2.4",
