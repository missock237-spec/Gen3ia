    "recharts": "^3.9.2",
    "uuid": "^14.0.1",
    "zod": "^4.0.2",
    "zustand": "^5.0.6",
    "date-fns": "^4.1.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "class-variance-authority": "^0.7.1",
    "stripe": "^22.2.0",
    "ioredis": "^5.11.1",
    "bullmq": "^5.78.0",
    "nodemailer": "^9.0.3",
    "resend": "^6.12.4",
    "sonner": "^2.0.6",
    "framer-motion": "^12.23.2",
    "next-themes": "^0.4.6",
