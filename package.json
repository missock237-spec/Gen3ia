{
  "name": "genova-ai",
  "version": "1.0.0",
  "private": true,
  "description": "🤖 Genova AI Agent Operating System - SaaS Plateforme IA",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0",
    "bun": ">=1.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "audit": "bun audit --production || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "diagnostic": "bash scripts/diagnostic.sh",
    "security": "npm test src/__tests__/security/",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "security:audit": "bun audit --production && vitest run src/__tests__/security/"
  },
