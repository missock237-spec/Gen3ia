{
  "name": "@gen3ia/web",
  "version": "0.10.0",
  "private": true,
  "description": "Tests e2e (Playwright) — l'app Next.js vit à la racine src/ tant que la migration monorepo n'est pas complète.",
  "scripts": {
    "dev": "npm run test:e2e --workspace @gen3ia/web",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "build": "playwright test",
    "clean": "rm -rf test-results playwright-report"
  },
  "dependencies": {
    "@playwright/test": "^1"
  },
  "devDependencies": {
    "@types/uuid": "^10"
  }
}