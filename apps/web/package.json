{
  "name": "@gen3ia/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "clean": "rm -rf .next coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:security": "vitest run src/__tests__/security",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "security:audit": "npm audit --audit-level=high 2>&1; exit 0",
    "security:all": "npm run security:audit && npm run test:security",
    "docs:generate": "tsx scripts/generate-openapi.ts",
    "docs:serve": "next dev",
    "docs:open": "open http://localhost:3000/api/docs/swagger",
    "compute:benchmark": "curl -X POST http://localhost:3000/api/compute -H 'Content-Type: application/json' -d '{\"task\":\"benchmark\"}'"
  },
  "dependencies": {
    "@gen3ia/core": "workspace:*",
    "@prisma/client": "^6.11.1",
    "@sentry/nextjs": "^8",
    "@tanstack/react-query": "^5.82.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.78.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.10",
    "openai": "^4.90.0",
    "pg": "^8.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.60.0",
    "recharts": "^2.15.4",
    "sharp": "^0.34.3",
    "sonner": "^2.0.6",
    "stripe": "^17.6.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "zod": "^4.0.2",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@gen3ia/core": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@playwright/test": "^1.52.0",
    "@vitest/coverage-v8": "^3.1.3",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "postcss": "^8",
    "prisma": "^6.11.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "vitest": "^3.1.3"
  },
  "overrides": {
    "braces": "3.0.3",
    "ws": "8.17.1",
    "cross-spawn": "7.0.6",
    "semver": "7.6.3",
    "cookie": "0.7.2",
    "axios": "1.7.9",
    "follow-redirects": "1.15.9",
    "path-to-regexp": "8.2.0",
    "micromatch": "4.0.8",
    "minimatch": "9.0.5",
    "tar": "6.2.1",
    "word-wrap": "1.2.5",
    "tough-cookie": "4.1.4",
    "json5": "2.2.3",
    "loader-utils": "3.3.1",
    "express": "4.21.1",
    "ejs": "3.1.10",
    "nth-check": "2.1.1",
    "postcss": "8.4.49",
    "rollup": "4.28.1",
    "preact": "10.26.5",
    "undici": "6.21.2",
    "jose": "5.9.6"
  }
}
