{
  "title": "Genova — Vue globale",
  "uid": "genova-overview",
  "schemaVersion": 39,
  "timezone": "utc",
  "panels": [
    { "id": 1, "type": "timeseries", "title": "API — p95 latence (ms)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" }] },
    { "id": 2, "type": "timeseries", "title": "Erreurs & rate-limit (429)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) by (route)", "legendFormat": "5xx {{route}}" },
        { "expr": "sum(rate(http_requests_total{status=\"429\"}[5m])) by (route)", "legendFormat": "429 {{route}}" } ] },
    { "id": 3, "type": "timeseries", "title": "Workers — par agent",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "genova_workers_active{agent=\"$agent\"}", "legendFormat": "active {{agent}}" }] },
    { "id": 4, "type": "timeseries", "title": "Crédits émis (total)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{ "expr": "sum(rate(genova_credits_total[5m]))", "legendFormat": "crédits/s" }] }
  ],
  "templating": { "list": [
    { "name": "agent", "type": "query", "datasource": { "uid": "prom" }, "query": "label_values(genova_workers_active, agent)" } ] }
}
