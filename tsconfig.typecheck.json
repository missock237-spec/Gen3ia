{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.typecheck.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "packages",
    "apps",
    "services",
    "crates",
    "src/__tests__",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
