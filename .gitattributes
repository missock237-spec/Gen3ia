# Gen3ia — Git Attributes

# Normalisation des fins de ligne
* text=auto eol=lf

# Fichiers binaires
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff2 binary

# Fichiers sensibles
.gitattributes export-ignore
.gitignore export-ignore
.env.example export-ignore
.editorconfig export-ignore
*.test.ts export-ignore
*.spec.ts export-ignore
