name: Sync Secrets to Vercel & Deploy
on:
  push:
    branches: [main]
  workflow_dispatch:

jobs:
  deploy:
    name: Sync Secrets + Deploy to Vercel
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7

      - name: Install Vercel CLI
        run: npm install -g vercel@latest

      - name: Sync secrets to Vercel
        run: |
          TOKEN="${{ secrets.VERCEL_TOKEN }}"
          if [ -z "$TOKEN" ]; then
            echo "❌ VERCEL_TOKEN manquant"
            echo "Ajoutez votre token Vercel dans GitHub Secrets"
            exit 1
          fi
          
          echo "🔐 Synchronisation des secrets vers Vercel..."
          
          # Lier le projet
          vercel link --project gen3ia --token "$TOKEN" --yes 2>/dev/null || true
          
          # Synchroniser chaque variable d'environnement vers Vercel
          for VAR in \
            "DATABASE_URL:${{ secrets.DATABASE_URL }}" \
            "AUTH_SECRET:${{ secrets.AUTH_SECRET }}" \
            "NEXTAUTH_SECRET:${{ secrets.NEXTAUTH_SECRET }}" \
            "NEXTAUTH_URL=https://gen3ia.vercel.app" \
            "NEXT_PUBLIC_APP_URL=https://gen3ia.vercel.app" \
            "OPENAI_API_KEY:${{ secrets.OPENAI_API_KEY }}" \
            "ANTHROPIC_API_KEY:${{ secrets.ANTHROPIC_API_KEY }}" \
            "GROQ_API_KEY:${{ secrets.GROQ_API_KEY }}" \
            "HUGGINGFACE_TOKEN:${{ secrets.HUGGINGFACE_TOKEN }}" \
            "GOOGLE_CLIENT_ID:${{ secrets.GOOGLE_CLIENT_ID }}" \
            "GOOGLE_CLIENT_SECRET:${{ secrets.GOOGLE_CLIENT_SECRET }}" \
            "GITHUB_CLIENT_ID:${{ secrets.GITHUB_CLIENT_ID }}" \
            "GITHUB_CLIENT_SECRET:${{ secrets.GITHUB_CLIENT_SECRET }}" \
            "SEBPAY_API_KEY:${{ secrets.SEBPAY_API_KEY }}" \
            "SEBPAY_API_SECRET:${{ secrets.SEBPAY_API_SECRET }}" \
            "SEBPAY_WEBHOOK_SECRET:${{ secrets.SEBPAY_WEBHOOK_SECRET }}" \
            "SENTRY_DSN:${{ secrets.SENTRY_DSN }}" \
            "REDIS_URL:${{ secrets.REDIS_URL }}"; do
            KEY="${VAR%%=*}"
            VALUE="${VAR#*=}"
            if [ -n "$VALUE" ]; then
              echo "   → $KEY"
              echo "$VALUE" | vercel env add "$KEY" production --token "$TOKEN" --yes 2>/dev/null || true
            fi
          done
          
          echo "✅ Secrets synchronises vers Vercel"

      - name: Deploy to Vercel
        run: |
          TOKEN="${{ secrets.VERCEL_TOKEN }}"
          echo "🚀 Deploiement vers Vercel..."
          vercel deploy --prod --token "$TOKEN" --yes 2>&1
          echo "✅ Deploiement termine"
