/**
 * Rate Limiter avec fallback in-memory.
 * Utilise Redis en production, Map en fallback.
 */

import { Redis } from "ioredis";
import { logger } from "@/lib/logger";

interface RateLimitResult {
  allowed: boolean;
  remaining: number;
  resetAt: number;
  limit: number;
}

class RateLimiter {
  private redis: Redis | null = null;
  private redisConnected = false;
  private fallback = new Map<string, { count: number; resetAt: number }>();

  constructor() {
    if (process.env.REDIS_URL) {
      try {
        this.redis = new Redis(process.env.REDIS_URL, {
          maxRetriesPerRequest: 1,
          retryStrategy: () => null,
          lazyConnect: true,
        });
        this.redis.on("error", () => { this.redisConnected = false; });
        this.redis.connect().then(() => {
          this.redisConnected = true;
        }).catch(() => {
          this.redisConnected = false;
        });
      } catch {
        this.redisConnected = false;
      }
    }
  }

  async check(key: string, limit: number, windowMs: number): Promise<RateLimitResult> {
    if (this.redisConnected && this.redis) {
      return this.checkRedis(key, limit, windowMs);
    }
    return this.checkFallback(key, limit, windowMs);
  }

  private async checkRedis(key: string, limit: number, windowMs: number): Promise<RateLimitResult> {
    try {
      const now = Date.now();
      const windowKey = Math.floor(now / windowMs);
      const redisKey = `ratelimit:${key}:${windowKey}`;

      const current = await this.redis!.incr(redisKey);
      if (current === 1) {
        await this.redis!.pexpire(redisKey, windowMs);
      }

      const ttl = await this.redis!.pttl(redisKey);
      const resetAt = now + (ttl > 0 ? ttl : windowMs);

      return {
        allowed: current <= limit,
        remaining: Math.max(0, limit - current),
        resetAt,
        limit,
      };
    } catch {
      this.redisConnected = false;
      return this.checkFallback(key, limit, windowMs);
    }
  }

  private checkFallback(key: string, limit: number, windowMs: number): RateLimitResult {
    const now = Date.now();
    const existing = this.fallback.get(key);

    if (!existing || now > existing.resetAt) {
      this.fallback.set(key, { count: 1, resetAt: now + windowMs });
      return { allowed: true, remaining: limit - 1, resetAt: now + windowMs, limit };
    }

    existing.count++;
    if (existing.count > limit) {
      return { allowed: false, remaining: 0, resetAt: existing.resetAt, limit };
    }

    return { allowed: true, remaining: limit - existing.count, resetAt: existing.resetAt, limit };
  }
}

export const rateLimiter = new RateLimiter();
