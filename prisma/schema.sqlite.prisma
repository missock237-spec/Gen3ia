generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// GEN3IA — Schéma de données
// Utilisateurs, agents, tâches, moteur d'orchestration,
// crédits, paiements Chariow, RAG, mémoire, audit.
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  role         String   @default("USER") // USER | ADMIN
  plan         String   @default("FREE") // FREE | PRO | ENTERPRISE
  credits      Float    @default(25)
  settings     String? // JSON : préférences (modèle par défaut, autonomie, confirmations…)
  chariowId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions            Session[]
  agents              Agent[]
  tasks               Task[]
  apiKeys             ApiKey[]
  transactions        Transaction[]
  payments            Payment[]
  documents           Document[]
  memories            Memory[]
  skills              Skill[]
  auditLogs           AuditLog[]
  connections         ConnectedAccount[]
  connectionRequests  ConnectionRequest[]
  externalConnections ExternalConnection[]
  watchConfigs        WatchConfig[]
  swarmSessions       SwarmSession[]
  batchTasks          BatchTask[]
  fineTuneJobs        FineTuneJob[]
  autoSkills          AutoSkill[]
  webhooks            WebhookConfig[]
  profile             UserProfile?
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Agent {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  slug         String   @unique
  description  String?
  systemPrompt String?
  provider     String   @default("auto") // auto | zai | glm | openrouter | groq | openai | huggingface
  model        String   @default("auto")
  temperature  Float    @default(0.7)
  maxTokens    Int      @default(4096)
  status       String   @default("DRAFT") // DRAFT | PUBLISHED | PAUSED | ARCHIVED
  visibility   String   @default("PRIVATE") // PRIVATE | MARKETPLACE
  category     String?
  tags         String? // JSON : ["analyse", "rédaction"]
  config       String? // JSON : { tools, skills, guardrails, memory, rag, autonomy }
  stats        String? // JSON : { runs, success, failed, tokens, credits, avgLatencyMs }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks   Task[]
  reviews MarketplaceReview[]
  listing AgentListing?

  @@index([userId])
  @@index([status, visibility])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId    String?
  name       String
  prefix     String // 12 premiers caractères, affichables
  keyHash    String    @unique // SHA-256 du secret complet
  scopes     String    @default("chat,analyze,task") // CSV
  requests   Int       @default(0)
  revoked    Boolean   @default(false)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Machine à états d'une tâche :
// QUEUED -> ANALYZING -> PLANNING -> SIMULATING -> EXECUTING -> VERIFYING
//   -> LEARNING -> COMPLETED
// WAITING_FOR_HUMAN (depuis SIMULATING/EXECUTING, reprend vers l'état d'origine)
// FAILED / CANCELLED (terminal)
model Task {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId         String?
  agent           Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  prompt          String
  status          String    @default("QUEUED")
  analysis        String? // JSON : PromptAnalysis
  plans           String? // JSON : Plan[5]
  planScores      String? // JSON : scores d'évaluation
  selectedPlanId  String?
  executionLog    String? // JSON : journaux d'exécution
  verification    String? // JSON : rapport de vérification
  correctionLog   String? // JSON : historique des auto-corrections
  learning        String? // JSON : leçons extraites
  result          String? // JSON : { answer, evidence, artifacts, metrics }
  pendingApproval String? // JSON : approbation humaine en attente
  costCredits     Float     @default(0)
  tokensIn        Int       @default(0)
  tokensOut       Int       @default(0)
  attempts        Int       @default(0)
  totalRetries    Int       @default(0) // plafond global de retries (circuit breaker)
  version         Int       @default(0) // verrouillage optimiste des fusions JSON
  error           String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  steps     TaskStep[]
  artifacts TaskArtifact[]

  @@index([userId, createdAt])
  @@index([status])
}

model TaskStep {
  id         String    @id @default(cuid())
  taskId     String
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  phase      String // ANALYZING | PLANNING | SIMULATING | EXECUTING | CORRECTING | VERIFYING | LEARNING | DELIVERING
  stepIndex  Int       @default(0)
  title      String
  detail     String? // JSON : données propres à l'étape
  status     String    @default("PENDING") // PENDING | RUNNING | DONE | FAILED | SKIPPED | WAITING
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([taskId])
}

model Transaction {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String // TASK_EXECUTION | PLAN_GENERATION | AGENT_DEPLOY | TOPUP | SUBSCRIPTION | REFUND | BONUS | ADJUSTMENT
  amount       Float // positif = crédit, négatif = débit
  balanceAfter Float
  description  String
  refType      String?
  refId        String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model Payment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String   @default("chariow")
  checkoutId String? // identifiant de transaction Chariow
  plan       String?
  amount     Float
  currency   String   @default("XOF")
  credits    Float    @default(0)
  status     String   @default("PENDING") // PENDING | SUCCEEDED | FAILED
  raw        String? // JSON : charge utile du webhook
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Document {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId    String?
  title      String
  sourceType String   @default("TEXT") // TEXT | FILE | URL
  content    String
  chunks     String? // JSON : morceaux indexés pour le RAG
  size       Int      @default(0)
  createdAt  DateTime @default(now())

  embeddings Embedding[]

  @@index([userId])
}

model Memory {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId    String?
  layer      String // SHORT_TERM | LONG_TERM | TASK | USER | AGENT
  content    String
  importance Float     @default(0.5)
  metadata   String? // JSON
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, layer])
}

model Skill {
  id          String   @id @default(cuid())
  userId      String? // null = compétence intégrée
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String   @unique
  name        String
  description String
  category    String   @default("GENERAL")
  definition  String? // JSON : { instructions, tools, examples }
  isPublic    Boolean  @default(false)
  installs    Int      @default(0)
  createdAt   DateTime @default(now())
}

model Tool {
  id          String   @id @default(cuid())
  userId      String? // null = catalogue intégré
  key         String   @unique
  name        String
  description String
  category    String   @default("GENERAL")
  parameters  String? // JSON : schéma des paramètres
  isBuiltIn   Boolean  @default(false)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model MarketplaceReview {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([agentId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  detail     String? // JSON
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// ============================================================
// Améliorations v3.1 — vecteurs, cache, télémétrie, config, artefacts
// ============================================================

model Embedding {
  id         String   @id @default(cuid())
  userId     String
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  chunkText  String
  embedding  String // JSON : number[]
  dim        Int
  norm       Float // norme L2 précalculée (accélère la similarité cosinus)
  model      String // fournisseur d'embedding (openai/..., local/hash-256…)
  createdAt  DateTime @default(now())

  @@index([userId, documentId])
  @@index([userId, model])
}

model PlanCache {
  id             String   @id @default(cuid())
  userId         String
  promptHash     String // SHA-256 du prompt normalisé
  prompt         String
  embedding      String? // JSON : number[] — recherche sémantique
  plans          String // JSON : Plan[]
  planScores     String // JSON : évaluation complète
  selectedPlanId String
  hitCount       Int      @default(0)
  lastUsedAt     DateTime @default(now())
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([userId, promptHash])
  @@index([userId, lastUsedAt])
}

model EngineRun {
  id         String   @id @default(cuid())
  engine     String // PROMPT_ANALYSIS | PLANNER | EVALUATOR | EXECUTOR | VERIFICATION | SELF_CORRECTION | LEARNING | ORCHESTRATOR
  taskId     String?
  userId     String?
  phase      String?
  ok         Boolean
  errorCode  String?
  durationMs Int
  attempts   Int      @default(1)
  tokensIn   Int      @default(0)
  tokensOut  Int      @default(0)
  credits    Float    @default(0)
  detail     String? // JSON : contexte (outils utilisés, stratégie de plan…)
  createdAt  DateTime @default(now())

  @@index([engine, createdAt])
  @@index([taskId])
}

// Connexions d'applications externes via Composio (1000+ apps réelles).
// Les jetons OAuth vivent CHEZ Composio — GEN3IA ne stocke que l'identifiant

// Configuration système éditable depuis l'interface admin (KV JSON).
model SystemConfig {
  key       String   @id
  value     String // JSON
  updatedAt DateTime @updatedAt
}

model TaskArtifact {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind      String // EVIDENCE | STEP_OUTPUT | EXECUTION_RESULT | PHASE_OUTPUT
  phase     String?
  stepIndex Int?
  payload   String // gzip + base64
  bytes     Int // taille décompressée
  createdAt DateTime @default(now())

  @@index([taskId])
}

// ─────────────────────────────────────────────────────────────
// CONNECTORS — comptes connectés (moteur local, architecture
// adaptée de Composio — MIT, Sampark Inc.). Secrets chiffrés
// AES-256-GCM : jamais de token en clair en base.
// ─────────────────────────────────────────────────────────────
model ConnectedAccount {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  appSlug       String // github | slack | gmail | calendar | notion | …
  status        String    @default("INITIALIZING") // INITIALIZING | INITIATED | ACTIVE | FAILED | EXPIRED | REVOKED
  authScheme    String // OAUTH2 | OAUTH1 | API_KEY | BEARER_TOKEN | BASIC | NO_AUTH
  encryptedData String // JSON ConnectionData chiffré AES-256-GCM (access/refresh token, secrets)
  meta          String? // JSON non sensible : { scopes, accountHint, tokenExpiresAt }
  lastError     String?
  lastRefreshAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, appSlug])
  @@index([userId])
  @@index([appSlug, status])
}

// Demande de connexion en cours : state anti-CSRF + verifier PKCE
// (chiffrés), sert de handshake entre initiate et callback OAuth.
model ConnectionRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appSlug     String
  status      String   @default("PENDING") // PENDING | COMPLETED | FAILED | EXPIRED
  redirectUri String? // URL UI de retour après connexion
  state       String   @unique // HMAC-signé, à usage unique
  verifierEnc String? // code_verifier PKCE chiffré (OAuth2 avec PKCE)
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([userId])
  @@index([appSlug, status])
}

// ============================================================
// v3.3 — Multi-Agents & Swarm
// ============================================================

model SwarmSession {
  id             String   @id @default(cuid())
  taskId         String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy       String   @default("HIERARCHICAL")
  status         String   @default("RUNNING")
  prompt         String
  plan           String?
  result         String?
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  costCredits    Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subTasks       SubTask[]
  sharedMemories SharedMemory[]
  messages       SwarmMessage[]

  @@index([userId, createdAt])
  @@index([status])
}

model SubTask {
  id             String   @id @default(cuid())
  sessionId      String
  session        SwarmSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title          String
  description    String
  assignedAgent  String
  status         String   @default("PENDING")
  dependencies   String?
  input          String?
  result         String?
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sessionId])
}

model SharedMemory {
  id         String        @id @default(cuid())
  sessionId  String?
  session    SwarmSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId     String?
  key        String
  value      String
  author     String
  namespace  String   @default("default")
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sessionId, namespace, key])
}

model SwarmMessage {
  id         String   @id @default(cuid())
  sessionId  String
  session    SwarmSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  channel    String
  senderId   String
  content    String
  payload    String?
  createdAt  DateTime @default(now())

  @@index([sessionId, channel])
}

// ============================================================
// v3.3 — Exécution autonome avancée
// ============================================================

model TaskPriority {
  id        String   @id @default(cuid())
  taskId    String   @unique
  cost      Float    @default(0.33)
  speed     Float    @default(0.33)
  accuracy  Float    @default(0.34)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExplorationRun {
  id           String   @id @default(cuid())
  taskId       String
  variantCount Int
  winnerPlanId String
  results      String
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([taskId])
}

// ============================================================
// v3.3 — Apprentissage & personnalisation
// ============================================================

model FineTuneJob {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  status      String   @default("QUEUED") // QUEUED | RUNNING | COMPLETED | FAILED | CANCELLED
  datasetPath String?
  datasetSize Int      @default(0)
  baseModel   String
  engine      String   @default("unsloth") // unsloth | axolotl
  config      String?  // JSON
  metrics     String?  // JSON : loss, eval_loss, epochs
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
}

model AutoSkill {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern     String  // pattern détecté
  code        String  // code généré
  language    String  @default("typescript")
  status      String  @default("DRAFT") // DRAFT | VALIDATED | PUBLISHED | REJECTED
  usageCount  Int     @default(0)
  successRate Float   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  responseStyle   String   @default("balanced") // concise | balanced | detailed
  tone            String   @default("professional") // professional | casual | formal
  language        String   @default("fr")
  detailLevel     Float    @default(0.5) // 0-1
  preferences     String?  // JSON
  interactionCount Int    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================
// v3.3 — Gouvernance & sécurité
// ============================================================

model ImmutableAuditLog {
  id         String   @id @default(cuid())
  userId     String?
  prevHash   String?  // hash de l'entrée précédente (chaîne)
  entryHash  String   // HMAC-SHA256 du contenu
  action     String
  entityType String?
  entityId   String?
  detail     String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model AnomalyAlert {
  id           String   @id @default(cuid())
  userId       String?
  type         String   // LOOP | COST_SPIKE | FAILURE_RATE | LATENCY
  severity     String   @default("WARNING") // INFO | WARNING | CRITICAL
  message      String
  metric       String?
  threshold    Float?
  actualValue  Float?
  action       String   @default("ALERT") // ALERT | THROTTLE | BLOCK
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([resolved])
}

// ============================================================
// v3.3 — Observabilité & tracing
// ============================================================

model Trace {
  id         String   @id @default(cuid())
  traceId    String   @unique
  taskId     String?
  userId     String?
  rootSpanId String?
  status     String   @default("RUNNING")
  durationMs Int      @default(0)
  spans      Int      @default(0)
  createdAt  DateTime @default(now())

  spanList   TraceSpan[]

  @@index([taskId])
  @@index([createdAt])
}

model TraceSpan {
  id            String   @id @default(cuid())
  traceId       String
  trace        Trace     @relation(fields: [traceId], references: [id], onDelete: Cascade)
  spanId       String
  parentSpanId String?
  name         String
  startTime    Float
  endTime      Float?
  durationMs   Int      @default(0)
  attributes   String?  // JSON
  status       String   @default("UNSET") // OK | ERROR | UNSET
  events       String?  // JSON
  createdAt    DateTime @default(now())

  @@index([traceId])
}

// ============================================================
// v3.3 — Batch
// ============================================================

model BatchTask {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String?
  status      String   @default("PENDING") // PENDING | RUNNING | COMPLETED | PARTIAL | FAILED
  total       Int      @default(0)
  completed   Int      @default(0)
  failed      Int      @default(0)
  results     String?  // JSON agrégé
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       BatchItem[]

  @@index([userId, createdAt])
}

model BatchItem {
  id         String   @id @default(cuid())
  batchId    String
  batch      BatchTask @relation(fields: [batchId], references: [id], onDelete: Cascade)
  taskId     String?
  prompt     String
  status     String   @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  result     String?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([batchId])
}

// ============================================================
// v3.3 — Écosystème & partage
// ============================================================

model AgentListing {
  id          String   @id @default(cuid())
  agentId     String   @unique
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  price       Float    @default(0) // 0 = gratuit
  currency    String   @default("XOF")
  commission  Float    @default(0.1) // 10% par défaut
  description String?
  tags        String?  // JSON
  downloads   Int      @default(0)
  purchases   Int      @default(0)
  revenue     Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Purchase {
  id          String   @id @default(cuid())
  buyerId     String
  sellerId    String
  agentId     String
  listingId   String
  amount      Float
  commission  Float
  payout      Float
  status      String   @default("PENDING") // PENDING | COMPLETED | REFUNDED
  createdAt   DateTime @default(now())

  @@index([buyerId])
  @@index([sellerId])
}

model WebhookConfig {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  events    String   // JSON : ["task.completed", "task.failed"]
  secret    String   // pour signature HMAC
  agentId   String?
  taskId    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([userId])
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  webhookId    String
  webhook      WebhookConfig @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  payload      String
  statusCode   Int?
  response     String?
  attempt      Int      @default(1)
  error        String? // message d'erreur réseau (livraison impossible)
  deliveredAt  DateTime?
  createdAt    DateTime @default(now())

  @@index([webhookId, createdAt])
}

model ExternalConnection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // postgresql | mysql | mongodb | salesforce | hubspot | notion | slack
  name      String
  config    String   // JSON encrypté (host, port, database, credentials…)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type])
}

model WatchConfig {
  id           String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  type        String   // PRICE | WEBSITE | INDICATOR | CUSTOM
  target      String   // URL ou identifiant
  schedule    String   // expression CRON
  condition   String?  // JSON : { operator: "lt", value: 100 }
  alertChannel String  @default("email") // email | slack | webhook
  alertTarget String?  // email/Slack channel/webhook URL
  lastValue   String?
  lastCheckAt DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  executions WatchExecution[]

  @@index([userId, active])
}

model WatchExecution {
  id           String   @id @default(cuid())
  watchId      String
  watch        WatchConfig @relation(fields: [watchId], references: [id], onDelete: Cascade)
  value        String?
  triggered    Boolean  @default(false)
  alertSent    Boolean  @default(false)
  error        String?
  executedAt   DateTime @default(now())

  @@index([watchId, executedAt])
}
