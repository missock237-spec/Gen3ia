generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("GENOVA_DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("user")
  plan      String   @default("free")
  credits   Int      @default(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions    CodeSession[]
  executions  CodeExecution[]
  deployments CodeDeployment[]
  apiKeys     ApiKey[]
}

model CodeSession {
  id              String   @id
  userId          String
  code            String   @db.Text
  language        String   @default("javascript")
  name            String?
  executionCount  Int      @default(0)
  isPublic        Boolean  @default(false)
  shareToken      String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastExecutedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([shareToken])
}

model CodeExecution {
  id        String   @id @default(cuid())
  sessionId String?
  userId    String
  code      String   @db.Text
  language  String   @default("javascript")
  output    String   @db.Text
  success   Boolean
  error     String?  @db.Text
  duration  Int
  tokens    Int      @default(0)
  createdAt DateTime @default(now())

  user    User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session CodeSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
}

model CodeDeployment {
  id             String   @id
  userId         String
  name           String
  type           String
  code           String   @db.Text
  url            String   @unique
  method         String   @default("GET")
  allowedOrigins String[] @default(["*"])
  callCount      Int      @default(0)
  active         Boolean  @default(true)
  lastCalled     DateTime?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  key       String   @unique
  plan      String   @default("free")
  active    Boolean  @default(true)
  lastUsed  DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([key])
}

model OrchestrationGoal {
  id          String   @id
  userId      String
  description String   @db.Text
  priority    String   @default("medium")
  status      String   @default("planning")
  summary     String?  @db.Text
  duration    Int?
  createdAt   DateTime @default(now())
  completedAt DateTime?

  tasks  OrchestrationTask[]
  agents OrchestrationAgent[]

  @@index([userId])
}

model OrchestrationTask {
  id            String   @id
  goalId        String
  description   String   @db.Text
  requiredRole  String
  agentId       String?
  status        String   @default("pending")
  dependencies  String[]
  result        String?  @db.Text
  error         String?  @db.Text
  attempts      Int      @default(0)
  maxAttempts   Int      @default(3)
  createdAt     DateTime @default(now())
  startedAt     DateTime?
  completedAt   DateTime?

  goal OrchestrationGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model OrchestrationAgent {
  id          String   @id
  goalId      String
  role        String
  name        String
  status      String   @default("idle")
  currentTask String?
  output      String?  @db.Text
  logs        String[]
  createdAt   DateTime @default(now())

  goal OrchestrationGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  agentId   String?
  action    String
  provider  String?
  endpoint  String?
  status    Int
  duration  Int
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}