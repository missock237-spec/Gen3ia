generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

model User {
  id String @id @default(cuid()) email String @unique name String? password String? avatar String?
  plan String @default("free") role String @default("user") credits Int @default(0)
  isActive Boolean @default(true) isEmailVerified Boolean @default(false)
  totpSecret String? backupCodes String? @db.Text isTwoFactorEnabled Boolean @default(false) twoFactorVerifiedAt DateTime?
  isCreator Boolean @default(false) creatorEarnings Float @default(0) creatorWithdrawn Float @default(0)
  lastActiveAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt
  agents Agent[] agentSuites AgentSuite[] agentMemories AgentMemory[] improvementLogs ImprovementLog[]
  sessions Session[] apiKeys ApiKey[] conversations Conversation[] tasks Task[] workflows Workflow[]
  workflowTemplates WorkflowTemplate[] guardrails Guardrail[]
  subscription Subscription? invoices Invoice[] credit Credit?
  creditTransactions CreditTransaction[] agentExecutions AgentExecution[] activityLogs ActivityLog[]
  emailVerifications EmailVerification[]
  marketplaceListings MarketplaceListing[] marketplacePurchases MarketplacePurchase[] marketplaceReviews MarketplaceReview[]
  creatorPayouts CreatorPayout[]
  accessKeys AccessKey[] agentPermissions AgentPermission[] voiceCalls VoiceCall[]
  agentActionLogs AgentActionLog[] approvedActions ApprovedAction[] pendingActions PendingAction[]
  mCPConnectors MCPConnector[]
  collaboratorOn WorkflowCollaborator[]
  agentTools AgentTool[] agentInvocations AgentInvocation[]
  dashboards Dashboard[] datasets Dataset[] queryLogs QueryLog[]
  alertRules AlertRule[] alertEvents AlertEvent[]
  webhookConfigs WebhookConfig[] plugins Plugin[] notifications Notification[]
  @@index([email, isActive]) @@index([plan]) @@index([role]) @@index([isCreator]) @@index([lastActiveAt])
}
model Notification { id String @id @default(cuid()) userId String type String title String message String @default("") @db.Text link String? icon String @default("bell") severity String @default("info") read Boolean @default(false) readAt DateTime? metadata String @default("{}") @db.Text createdAt DateTime @default(now()) user User @relation(fields: [userId], references: [id], onDelete: Cascade) @@index([userId, read, createdAt]) }
model WebhookConfig { id String @id @default(cuid()) userId String name String url String @db.Text method String @default("POST") headers String @default("{}") @db.Text secret String? @db.Text retryCount Int @default(3) timeout Int @default(10000) template String @default("{}") @db.Text enabled Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields: [userId], references: [id], onDelete: Cascade) logs WebhookLog[] }
model WebhookLog { id String @id @default(cuid()) configId String? status String statusCode Int @default(0) durationMs Int @default(0) responseBody String? @db.Text error String? @db.Text attempts Int @default(1) metadata String @default("{}") @db.Text createdAt DateTime @default(now()) config WebhookConfig? @relation(fields: [configId], references: [id], onDelete: SetNull) @@index([configId, createdAt]) }
model Plugin { id String @id @default(cuid()) name String version String @default("1.0.0") description String @default("") @db.Text type String @default("block") icon String @default("plug") category String @default("custom") authorId String schema String @default("{}") @db.Text permissions String @default("[]") @db.Text hooks String @default("{}") @db.Text sourceUrl String? @db.Text status String @default("draft") usageCount Int @default(0) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt author User @relation(fields: [authorId], references: [id]) executions PluginExecution[] @@index([authorId, status]) @@index([type, status]) }
model PluginExecution { id String @id @default(cuid()) pluginId String userId String workflowId String? inputs String @db.Text output String @db.Text durationMs Int @default(0) status String @default("success") error String? @db.Text createdAt DateTime @default(now()) plugin Plugin @relation(fields: [pluginId], references: [id], onDelete: Cascade) @@index([pluginId, createdAt]) @@index([userId, createdAt]) }
model AlertRule { id String @id @default(cuid()) userId String name String description String @default("") @db.Text agentId String? condition String threshold Float @default(0) windowMinutes Int @default(60) channels String @default("[]") @db.Text webhookUrl String? @db.Text enabled Boolean @default(true) lastTriggeredAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields: [userId], references: [id], onDelete: Cascade) events AlertEvent[] @@index([userId, enabled]) @@index([agentId]) }
model AlertEvent { id String @id @default(cuid()) ruleId String userId String agentId String? type String severity String @default("warning") title String message String @db.Text metadata String @default("{}") @db.Text channelsSent String @default("[]") @db.Text read Boolean @default(false) createdAt DateTime @default(now()) rule AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade) user User @relation(fields: [userId], references: [id]) @@index([userId, createdAt]) @@index([ruleId, createdAt]) @@index([severity, read]) }
model MarketplaceListing { id String @id @default(cuid()) name String slug String @unique description String @db.Text type String @default("agent") price Float @default(0) status String @default("draft") isActive Boolean @default(true) rating Float @default(0) reviewCount Int @default(0) userId String agentId String? config String @default("{}") @db.Text badges String @default("[]") @db.Text trustScore Float @default(0) autoTestStatus String @default("pending") autoTestResult String? @db.Text createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields: [userId], references: [id]) reviews MarketplaceReview[] purchases MarketplacePurchase[] @@index([status, isActive]) @@index([type]) @@index([slug]) }
model MarketplaceReview { id String @id @default(cuid()) listingId String userId String rating Int title String @default("") content String @default("") @db.Text status String @default("published") metadata String @default("{}") @db.Text createdAt DateTime @default(now()) updatedAt DateTime @updatedAt listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade) user User @relation(fields: [userId], references: [id]) @@unique([userId, listingId]) @@index([listingId, status]) }
model MarketplacePurchase { id String @id @default(cuid()) listingId String userId String status String @default("pending") price Float @default(0) metadata String @default("{}") @db.Text createdAt DateTime @default(now()) updatedAt DateTime @updatedAt listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade) user User @relation(fields: [userId], references: [id]) @@unique([userId, listingId]) @@index([userId]) @@index([listingId]) }
model Dataset { id String @id @default(cuid()) name String description String @default("") @db.Text source String connectionConfig String @default("{}") @db.Text schemaInfo String @default("[]") @db.Text sampleData String @default("[]") @db.Text rowCount Int @default(0) lastSyncedAt DateTime? refreshInterval Int @default(0) status String @default("active") userId String tags String @default("[]") @db.Text createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields: [userId], references: [id], onDelete: Cascade) dashboards Dashboard[] queryLogs QueryLog[] @@index([userId, status]) }
model QueryLog { id String @id @default(cuid()) datasetId String? userId String naturalLanguage String @db.Text generatedQuery String @db.Text queryType String @default("sql") result String @default("{}") @db.Text chartConfig String? @db.Text isError Boolean @default(false) errorMessage String? @db.Text executionTimeMs Int @default(0) tokensUsed Int @default(0) createdAt DateTime @default(now()) user User @relation(fields: [userId], references: [id]) dataset Dataset? @relation(fields: [datasetId], references: [id]) @@index([userId, createdAt]) @@index([datasetId]) }
model Dashboard { id String @id @default(cuid()) name String description String @default("") @db.Text layout String @default("[]") @db.Text widgets String @default("[]") @db.Text filters String @default("[]") @db.Text isPublic Boolean @default(false) userId String datasetId String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields: [userId], references: [id], onDelete: Cascade) dataset Dataset? @relation(fields: [datasetId], references: [id]) @@index([userId]) @@index([isPublic]) }
model Agent { id String @id @default(cuid()) name String type String @default("assistant") role String @default("assistant") description String @default("") systemPrompt String @default("") @db.Text instructions String @default("") @db.Text model String @default("gpt-4o-mini") temperature Float @default(0.7) maxTokens Int @default(4096) status String @default("active") category String @default("custom") tags String @default("[]") @db.Text isPublic Boolean @default(false) isMarketplacePublished Boolean @default(false) usageCount Int @default(0) ownerId String? suiteId String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt owner User? @relation(fields: [ownerId], references: [id]) tools AgentTool[] memories AgentMemory[] delegationsReceived AgentDelegation[] @relation("AgentDelegationTarget") delegationsMade AgentDelegation[] @relation("AgentDelegationSource") checkpoints AgentCheckpoint[] autonomousRuns AutonomousRun[] @@index([ownerId, status]) @@index([type, role]) @@index([isMarketplacePublished]) }
model AgentTool { id String @id @default(cuid()) agentId String name String description String @default("") @db.Text type String @default("function") config String @default("{}") @db.Text enabled Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade) @@index([agentId]) }
model AgentMemory { id String @id @default(cuid()) agentId String userId String category String @default("episodic") content String @db.Text metadata String @default("{}") @db.Text importance Float @default(0.5) expiresAt DateTime? createdAt DateTime @default(now()) agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade) @@index([agentId, userId, category]) }
model AgentDelegation { id String @id @default(cuid()) sourceAgentId String targetAgentId String task String @db.Text context String @default("") @db.Text status String @default("pending") priority Int @default(0) maxWaitMs Int @default(60000) result String? @db.Text error String? @db.Text startedAt DateTime? completedAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt sourceAgent Agent @relation("AgentDelegationSource", fields: [sourceAgentId], references: [id], onDelete: Cascade) targetAgent Agent @relation("AgentDelegationTarget", fields: [targetAgentId], references: [id], onDelete: Cascade) @@index([sourceAgentId, status]) @@index([targetAgentId, status]) }
model AutonomousRun { id String @id @default(cuid()) agentId String userId String goal String @db.Text instructions String @default("") @db.Text status String @default("pending") schedule String @default("") maxDurationMs Int @default(3600000) checkpointsConfig String @default("[]") @db.Text currentCheckpointId String? result String? @db.Text progress String @default("[]") @db.Text startedAt DateTime? pausedAt DateTime? completedAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade) checkpoints AgentCheckpoint[] @@index([agentId, status]) @@index([userId, status]) }
model AgentCheckpoint { id String @id @default(cuid()) runId String agentId String type String @default("approval") title String description String @default("") @db.Text status String @default("pending") context String @default("{}") @db.Text decision String? @db.Text decidedBy String? decidedAt DateTime? createdAt DateTime @default(now()) run AutonomousRun @relation(fields: [runId], references: [id], onDelete: Cascade) agent Agent @relation(fields: [agentId], references: [id]) @@index([runId, status]) @@index([agentId, status]) }
model AgentInvocation { id String @id @default(cuid()) agentId String userId String input String @db.Text output String @db.Text model String tokensUsed Int @default(0) cost Float @default(0) durationMs Int @default(0) metadata String @default("{}") @db.Text createdAt DateTime @default(now()) user User @relation(fields: [userId], references: [id]) @@index([agentId, createdAt]) @@index([userId, createdAt]) }
model AgentSuite { id String @id @default(cuid()) name String goal String @default("") @db.Text strategy String @default("sequential") status String @default("draft") userId String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields: [userId], references: [id], onDelete: Cascade) agents Agent[] executions AgentSuiteExecution[] }
model AgentSuiteAgent { id String @id @default(cuid()) suiteId String agentId String order Int role String @default("member") createdAt DateTime @default(now()) suite AgentSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade) }
model AgentSuiteExecution { id String @id @default(cuid()) suiteId String userId String goal String @db.Text context String? @db.Text status String @default("running") strategy String @default("sequential") result String? @db.Text totalCost Float @default(0) totalTokens Int @default(0) rounds Int @default(0) startedAt DateTime @default(now()) completedAt DateTime? suite AgentSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade) messages AgentSuiteMessage[] }
model AgentSuiteMessage { id String @id @default(cuid()) executionId String agentId String? role String content String @db.Text type String @default("message") round Int @default(1) createdAt DateTime @default(now()) execution AgentSuiteExecution @relation(fields: [executionId], references: [id], onDelete: Cascade) }
model Workflow { id String @id @default(cuid()) name String description String @default("") steps String @default("[]") @db.Text trigger String @default("manual") status String @default("draft") userId String activeBranchId String? currentVersionId String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields: [userId], references: [id], onDelete: Cascade) branches WorkflowBranch[] versions WorkflowVersion[] collaborators WorkflowCollaborator[] @@index([userId, status]) @@index([userId, trigger]) @@index([trigger, status]) @@index([status]) }
model WorkflowVersion { id String @id @default(cuid()) workflowId String branchId String version Int steps String @db.Text name String @default("") message String @default("") @db.Text userId String parentVersionId String? createdAt DateTime @default(now()) workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade) branch WorkflowBranch @relation(fields: [branchId], references: [id], onDelete: Cascade) parent WorkflowVersion? @relation("VersionParent", fields: [parentVersionId], references: [id]) children WorkflowVersion[] @relation("VersionParent") @@unique([workflowId, branchId, version]) @@index([workflowId, branchId]) @@index([workflowId, version]) @@index([createdAt]) }
model WorkflowBranch { id String @id @default(cuid()) workflowId String name String @default("main") description String @default("") sourceBranchId String? isDefault Boolean @default(false) isLocked Boolean @default(false) userId String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade) sourceBranch WorkflowBranch? @relation("BranchFork", fields: [sourceBranchId], references: [id]) forks WorkflowBranch[] @relation("BranchFork") versions WorkflowVersion[] @@unique([workflowId, name]) @@index([workflowId]) @@index([isDefault]) }
model WorkflowCollaborator { id String @id @default(cuid()) workflowId String userId String role String @default("editor") lastAccessAt DateTime? @default(now()) addedAt DateTime @default(now()) workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade) user User @relation(fields: [userId], references: [id], onDelete: Cascade) @@unique([workflowId, userId]) @@index([userId]) }
model WorkflowTemplate { id String @id @default(cuid()) name String description String @default("") category String @default("general") icon String @default("zap") steps String @default("[]") @db.Text isBuiltIn Boolean @default(true) usageCount Int @default(0) isPublic Boolean @default(false) tags String @default("[]") userId String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User? @relation(fields: [userId], references: [id]) @@index([category]) @@index([isBuiltIn]) @@index([usageCount]) @@index([isPublic]) }
model CreatorPayout { id String @id @default(cuid()) userId String amount Int status String @default("pending") @@index([userId, status]) }
model Conversation { id String @id @default(cuid()) title String type String @default("chat") userId String agentId String? @@index([userId, updatedAt]) }
model Message { id String @id @default(cuid()) role String content String @db.Text conversationId String @@index([conversationId, createdAt]) }
model ActivityLog { id String @id @default(cuid()) action String details String? @db.Text category String @default("general") userId String @@index([userId, createdAt]) }