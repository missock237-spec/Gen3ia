generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

model User {
  id String @id @default(cuid())
  email String @unique
  name String?
  password String?
  avatar String?
  plan String @default("free")
  role String @default("user")
  credits Int @default(0)
  isActive Boolean @default(true)
  isEmailVerified Boolean @default(false)
  totpSecret String?
  backupCodes String? @db.Text
  isTwoFactorEnabled Boolean @default(false)
  twoFactorVerifiedAt DateTime?
  lastActiveAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agents Agent[]
  agentSuites AgentSuite[]
  agentMemories AgentMemory[]
  improvementLogs ImprovementLog[]
  sessions Session[]
  apiKeys ApiKey[]
  conversations Conversation[]
  tasks Task[]
  workflows Workflow[]
  guardrails Guardrail[]
  whatsAppConfig WhatsAppConfig?
  voiceProfile VoiceProfile?
  subscription Subscription?
  invoices Invoice[]
  credit Credit?
  creditTransactions CreditTransaction[]
  agentExecutions AgentExecution[]
  activityLogs ActivityLog[]
  emailVerifications EmailVerification[]
  marketplaceListings MarketplaceListing[]
  marketplacePurchases MarketplacePurchase[]
  accessKeys AccessKey[]
  agentPermissions AgentPermission[]
  voiceCalls VoiceCall[]
  agentActionLogs AgentActionLog[]
  approvedActions ApprovedAction[]
  pendingActions PendingAction[]
  mCPConnectors MCPConnector[]
  @@index([email, isActive])
  @@index([plan]) @@index([role])
  @@index([isTwoFactorEnabled])
  @@index([lastActiveAt]) @@index([createdAt])
}

model Agent {
  id String @id @default(cuid())
  name String
  type String @default("assistant")
  role String @default("assistant")
  description String @default("")
  systemPrompt String? @db.Text
  model String @default("gpt-4o-mini")
  temperature Float @default(0.7)
  maxTokens Int @default(4096)
  config String @default("{}") @db.Text
  avatar String?
  status String @default("active")
  userId String
  suiteId String?
  successes Int @default(0)
  failures Int @default(0)
  avgTokensUse Int @default(0)
  avgExecutionTime Float @default(0)
  lastImprovedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  suite AgentSuite? @relation(fields: [suiteId], references: [id])
  tasks Task[]
  permissions AgentPermission[]
  conversations Conversation[]
  executions AgentExecution[]
  actionLogs AgentActionLog[]
  suiteMembers AgentSuiteAgent[]
  memories AgentMemory[]
  improvements ImprovementLog[]
  @@index([userId, status]) @@index([userId, type])
  @@index([userId, role]) @@index([suiteId]) @@index([status])
}

// ============================================================
// MEMORY & SELF-IMPROVEMENT
// ============================================================
model AgentMemory {
  id String @id @default(cuid())
  agentId String
  userId String
  category String @default("episodic")  // episodic | semantic | procedural | preference
  content String @db.Text
  context String? @db.Text
  source String @default("interaction") // interaction | observation | feedback | system
  relevance Float @default(0.5)
  accessCount Int @default(0)
  tags String @default("[]")
  embedding String? @db.Text
  createdAt DateTime @default(now())
  lastAccessedAt DateTime @default(now())
  expiresAt DateTime?
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([agentId, userId, category])
  @@index([agentId, relevance])
  @@index([agentId, lastAccessedAt])
  @@index([userId, category])
}

model ImprovementLog {
  id String @id @default(cuid())
  agentId String
  userId String
  action String // prompt_tuning | strategy_change | model_switch | memory_prune | threshold_adjust
  field String  // systemPrompt | temperature | model | maxTokens | strategy
  oldValue String? @db.Text
  newValue String? @db.Text
  reason String @db.Text
  metricsBefore String? @db.Text  // JSON
  metricsAfter String? @db.Text   // JSON
  score Float @default(0)
  createdAt DateTime @default(now())
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([agentId, createdAt])
  @@index([agentId, score])
}

// ============================================================
// SUITES MULTI-AGENTS
// ============================================================
model AgentSuite {
  id String @id @default(cuid())
  name String
  description String @default("")
  goal String? @db.Text
  userId String
  status String @default("idle")
  strategy String @default("sequential")
  maxRounds Int @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  agents AgentSuiteAgent[]
  executions AgentSuiteExecution[]
  memberAgent Agent? @relation(fields: [id], references: [suiteId])
  @@index([userId, status]) @@index([status])
}
model AgentSuiteAgent { id String @id @default(cuid()) suiteId String agentId String order Int @default(0) role String @default("member") suite AgentSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade) agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade) @@unique([suiteId, agentId]) @@index([suiteId]) @@index([agentId]) }
model AgentSuiteExecution { id String @id @default(cuid()) suiteId String userId String goal String @db.Text context String? @db.Text status String @default("pending") result String? @db.Text strategy String @default("sequential") rounds Int @default(0) totalCost Float @default(0) totalTokens Int @default(0) startedAt DateTime @default(now()) completedAt DateTime? suite AgentSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade) messages AgentSuiteMessage[] @@index([suiteId]) @@index([userId, status]) @@index([startedAt]) }
model AgentSuiteMessage { id String @id @default(cuid()) executionId String agentId String? agentName String? @default("") role String @default("agent") content String @db.Text type String @default("message") round Int @default(0) createdAt DateTime @default(now()) execution AgentSuiteExecution @relation(fields: [executionId], references: [id], onDelete: Cascade) @@index([executionId, round]) @@index([executionId, agentId]) }
model AgentPermission { id String @id @default(cuid()) permission String granted Boolean @default(false) requiresApproval Boolean @default(true) agentId String userId String agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade) user User @relation(fields: [userId], references: [id], onDelete: Cascade) @@unique([agentId, permission]) @@index([userId]) @@index([agentId, granted]) }
model AgentExecution { id String @id @default(cuid()) agentId String userId String task String? @db.Text status String @default("pending") provider String? result String? @db.Text error String? @db.Text totalTokens Int @default(0) estimatedCost Float @default(0) sessionId String? completedAt DateTime? createdAt DateTime @default(now()) agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade) user User @relation(fields: [userId], references: [id], onDelete: Cascade) @@index([userId, createdAt]) @@index([userId, status]) @@index([agentId, status]) @@index([agentId, completedAt]) @@index([createdAt]) @@index([provider]) }
model AgentActionLog { id String @id @default(cuid()) agentId String action String details String? @db.Text status String @default("pending") result String? @db.Text userId String createdAt DateTime @default(now()) resolvedAt DateTime? agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade) user User @relation(fields: [userId], references: [id], onDelete: Cascade) @@index([userId, createdAt]) @@index([agentId, status]) @@index([status, createdAt]) }

model Conversation { id String @id @default(cuid()) title String type String @default("chat") userId String agentId String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields: [userId], references: [id], onDelete: Cascade) agent Agent? @relation(fields: [agentId], references: [id]) messages Message[] @@index([userId, updatedAt]) @@index([userId, agentId]) @@index([userId, type]) @@index([agentId]) }
model Message { id String @id @default(cuid()) role String content String @db.Text conversationId String provider String @default("internal") createdAt DateTime @default(now()) conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade) @@index([conversationId, createdAt]) @@index([conversationId, role]) }

model ActivityLog { id String @id @default(cuid()) action String details String? @db.Text category String @default("general") userId String createdAt DateTime @default(now()) user User @relation(fields: [userId], references: [id], onDelete: Cascade) @@index([userId, createdAt]) @@index([userId, category]) @@index([action, createdAt]) @@index([category, createdAt]) @@index([createdAt]) }