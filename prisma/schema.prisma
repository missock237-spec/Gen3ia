// ============================================================
// GEN3IA PRISMA SCHEMA
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USER
// ============================================================
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  password        String?
  avatar          String?
  plan            String   @default("free")
  role            String   @default("user")
  credits         Int      @default(0)
  isActive        Boolean  @default(true)
  isEmailVerified Boolean  @default(false)
  lastActiveAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agents           Agent[]
  sessions         Session[]
  apiKeys          ApiKey[]
  conversations    Conversation[]
  tasks            Task[]
  workflows        Workflow[]
  guardrails       Guardrail[]
  whatsAppConfig   WhatsAppConfig?
  voiceProfile     VoiceProfile?
  subscription     Subscription?
  invoices         Invoice[]
  credit           Credit?
  creditTransactions CreditTransaction[]
  agentExecutions  AgentExecution[]
  activityLogs     ActivityLog[]
  emailVerifications EmailVerification[]
  marketplaceListings MarketplaceListing[]
  marketplacePurchases MarketplacePurchase[]
  accessKeys       AccessKey[]
  agentPermissions AgentPermission[]
  voiceCalls       VoiceCall[]
  agentActionLogs  AgentActionLog[]
  approvedActions  ApprovedAction[]
  pendingActions   PendingAction[]
}

// ============================================================
// AUTH / SESSION
// ============================================================
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  code      String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// AGENTS
// ============================================================
model Agent {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("assistant")
  description String   @default("")
  config      String   @default("{}") @db.Text
  avatar      String?
  status      String   @default("active")
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks         Task[]
  permissions   AgentPermission[]
  conversations Conversation[]
  executions    AgentExecution[]
  actionLogs    AgentActionLog[]
}

model AgentPermission {
  id               String  @id @default(cuid())
  permission       String
  granted          Boolean @default(false)
  requiresApproval Boolean @default(true)
  agentId          String
  userId           String

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agentId, permission])
}

model AgentExecution {
  id           String    @id @default(cuid())
  agentId      String
  userId       String
  task         String?   @db.Text
  status       String    @default("pending")
  provider     String?
  result       String?   @db.Text
  error        String?   @db.Text
  totalTokens  Int       @default(0)
  estimatedCost Float    @default(0)
  sessionId    String?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgentActionLog {
  id         String   @id @default(cuid())
  agentId    String
  action     String
  details    String?  @db.Text
  status     String   @default("pending")
  result     String?  @db.Text
  userId     String
  createdAt  DateTime @default(now())
  resolvedAt DateTime?

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// CONVERSATIONS & MESSAGES
// ============================================================
model Conversation {
  id        String   @id @default(cuid())
  title     String
  type      String   @default("chat")
  userId    String
  agentId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent    Agent?    @relation(fields: [agentId], references: [id])
  messages Message[]
}

model Message {
  id             String   @id @default(cuid())
  role           String
  content        String   @db.Text
  conversationId String
  provider       String   @default("internal")
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// ============================================================
// TASKS
// ============================================================
model Task {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  priority    String   @default("medium")
  status      String   @default("pending")
  agentId     String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agent Agent? @relation(fields: [agentId], references: [id])
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// WORKFLOWS
// ============================================================
model Workflow {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  steps       String   @default("[]") @db.Text
  trigger     String   @default("manual")
  status      String   @default("draft")
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// GUARDRAILS
// ============================================================
model Guardrail {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("content_filter")
  description String   @default("")
  rules       String   @default("{}") @db.Text
  severity    String   @default("warning")
  isActive    Boolean  @default(true)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// WHATSAPP
// ============================================================
model WhatsAppConfig {
  userId       String   @id
  phoneNumber  String?
  apiToken     String?  @db.Text
  phoneNumberId String?
  whatsappId   String?
  isActive     Boolean  @default(false)
  autoMessage  Boolean  @default(false)
  autoCall     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VoiceProfile {
  userId     String   @id
  voiceModel String   @default("alloy")
  speed      Float    @default(1.0)
  pitch      Float    @default(1.0)
  language   String   @default("fr-FR")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VoiceCall {
  id         String   @id @default(cuid())
  userId     String
  fromNumber String?
  toNumber   String
  provider   String   @default("twilio")
  status     String   @default("pending")
  metadata   String?  @db.Text
  duration   Int      @default(0)
  createdAt  DateTime @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// API KEYS & ACCESS
// ============================================================
model ApiKey {
  id        String    @id @default(cuid())
  name      String
  key       String    @unique
  scopes    String    @default("[]")
  lastUsed  DateTime?
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AccessKey {
  id        String   @id @default(cuid())
  keyValue  String   @unique
  name      String?
  isActive  Boolean  @default(true)
  scopes    String   @default("[]")
  lastUsed  DateTime?
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// BILLING & CREDITS
// ============================================================
model Credit {
  id        String    @id @default(cuid())
  balance   Int       @default(0)
  used      Int       @default(0)
  total     Int       @default(0)
  expiresAt DateTime?
  userId    String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id          String   @id @default(cuid())
  type        String   @default("credit")
  amount      Int
  description String   @default("")
  reference   String?
  userId      String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id               String    @id @default(cuid())
  plan             String    @default("free")
  status           String    @default("active")
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean  @default(false)
  userId           String    @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invoice {
  id        String   @id @default(cuid())
  amount    Float
  currency  String   @default("XAF")
  status    String   @default("pending")
  pdfUrl    String?
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// MARKETPLACE
// ============================================================
model MarketplaceListing {
  id           String   @id @default(cuid())
  type         String   @default("agent")
  name         String
  slug         String   @unique
  description  String   @default("")
  category     String   @default("general")
  tags         String   @default("[]")
  config       String   @default("{}") @db.Text
  price        Int      @default(0)
  status       String   @default("draft")
  rating       Float    @default(0)
  downloads    Int      @default(0)
  installCount Int      @default(0)
  isActive     Boolean  @default(true)
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases MarketplacePurchase[]
  reviews   MarketplaceReview[]
}

model MarketplacePurchase {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  price     Int      @default(0)
  currency  String   @default("credits")
  status    String   @default("completed")
  createdAt DateTime @default(now())

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model MarketplaceReview {
  id        String   @id @default(cuid())
  rating    Int
  content   String?
  listingId String
  userId    String
  createdAt DateTime @default(now())

  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// LOGGING & ACTIVITY
// ============================================================
model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  details   String?  @db.Text
  category  String   @default("general")
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApprovedAction {
  id          String   @id @default(cuid())
  actionId    String   @unique
  action      String
  description String?
  approvedBy  String?
  userId      String
  approvedAt  DateTime @default(now())
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PendingAction {
  id          String   @id @default(cuid())
  actionId    String   @unique
  action      String
  description String?
  status      String   @default("pending")
  userId      String
  createdAt   DateTime @default(now())
  expiresAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// SOCIAL & N8N
// ============================================================
model SocialAccount {
  id              String   @id @default(cuid())
  platform        String
  accountId       String
  accountName     String?
  accessToken     String?  @db.Text
  refreshToken    String?  @db.Text
  expiresAt       DateTime?
  userId          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([platform, accountId])
}

model N8nConfig {
  id             String   @id @default(cuid())
  host           String?
  protocol       String   @default("http")
  encryptionKey  String?  @db.Text
  webhookUrl     String?
  isActive       Boolean  @default(false)
  userId         String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
