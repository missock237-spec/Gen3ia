generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// GEN3IA — Schéma de données
// Utilisateurs, agents, tâches, moteur d'orchestration,
// crédits, paiements Chariow, RAG, mémoire, audit.
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  role         String   @default("USER") // USER | ADMIN
  plan         String   @default("FREE") // FREE | PRO | ENTERPRISE
  credits      Float    @default(25)
  settings     String? // JSON : préférences (modèle par défaut, autonomie, confirmations…)
  chariowId    String?
  githubId     String?  @unique
  googleId     String?  @unique
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions            Session[]
  agents              Agent[]
  tasks               Task[]
  apiKeys             ApiKey[]
  transactions        Transaction[]
  payments            Payment[]
  documents           Document[]
  memories            Memory[]
  skills              Skill[]
  auditLogs           AuditLog[]
  connections         ConnectedAccount[]
  connectionRequests  ConnectionRequest[]
  externalConnections ExternalConnection[]
  watchConfigs        WatchConfig[]
  swarmSessions       SwarmSession[]
  batchTasks          BatchTask[]
  fineTuneJobs        FineTuneJob[]
  autoSkills          AutoSkill[]
  webhooks            WebhookConfig[]
  profile             UserProfile?
  oauthIdentities     OAuthIdentity[]      @relation("OAuthIdentities")
  liveHostSessions    LiveSession[]        @relation("LiveHost")
  liveParticipations  LiveParticipant[]    @relation("LiveParticipants")
  adWallet            AdWallet?
  subscriptions       Subscription[]
  adCampaigns         AdCampaign[]
  oauthProvider       String? // dernier fournisseur OAuth utilisé : github | google
  modelSelections     ModelSelection[]
  hfJobs              HFJob[]
  storageObjects      StorageObject[]
}

// ─── Model & Compute Intelligence Layer (v4.0 — HF) ────────────
// Registre central des modèles : évolue SANS modification du code source
// (synchronisation HF Hub + éditions admin). Chaque entrée décrit un modèle
// joignable via un provider (HF Inference Providers, HF Inference Endpoints,
// Gemini, GLM, OpenRouter…).
model AIModel {
  id             String            @id @default(cuid())
  provider       String // huggingface | gemini | glm | openrouter | zai | groq | openai | custom
  modelId        String // identifiant exact chez le provider (ex: meta-llama/Llama-3.3-70B-Instruct)
  name           String
  architecture   String? // transformer | mamba | diffusion | moe…
  modality       String            @default("text") // text | multimodal | image | audio | video
  supportedTasks String // JSON : ["ANALYSIS","PLANNING","EXECUTION","VERIFICATION","LEARNING","CHAT","SUMMARIZATION","EMBEDDING","VISION"]
  contextLength  Int               @default(32000)
  parameterCount Float? // milliards de paramètres
  quantization   String? // fp16 | int8 | int4…
  vramGb         Float? // VRAM requise pour auto-hébergement
  capabilities   ModelCapability[]
  license        String?
  commercialUse  Boolean           @default(true)
  availability   String            @default("UNKNOWN") // AVAILABLE | DEGRADED | UNAVAILABLE | UNKNOWN
  endpointType   String            @default("ROUTER") // ROUTER (Inference Providers) | DEDICATED (Inference Endpoint) | COMPATIBLE
  endpointUrl    String? // URL directe (endpoint dédié ou baseUrl compatible)
  endpointId     String? // identifiant HF de l'endpoint dédié
  creditsPerKIn  Float             @default(0.4)
  creditsPerKOut Float             @default(1.2)
  costPerKTokens Float? // coût réel observé (US$/1k tokens, informatif)
  qualityScore   Float             @default(0.5) // 0-1 — agrégat des évaluations
  successRate    Float             @default(0.8) // 0-1 — taux de réussite réel observé
  avgLatencyMs   Float             @default(2000) // latence observée
  sampleCount    Int               @default(0) // exécutions mesurées
  lastEvaluated  DateTime?
  status         String            @default("ACTIVE") // ACTIVE | DISABLED | EXPERIMENTAL
  isDefault      Boolean           @default(false) // modèle par défaut du provider
  priority       Int               @default(100) // ordre de préférence statique (plus petit = prioritaire)
  tags           String? // JSON : ["coding","reasoning","vision","fast","cheap"]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  performances ModelPerformance[]
  selections   ModelSelection[]

  @@unique([provider, modelId])
  @@index([provider, status])
  @@index([status, qualityScore])
}

// Capacités fines d'un modèle (recherche par capacité, extension sans code).
model ModelCapability {
  id        String   @id @default(cuid())
  modelId   String
  model     AIModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  key       String // ex: "json-mode" | "streaming" | "function-calling" | "vision" | "long-context"
  value     String? // paramètre éventuel (ex: dimensions d'embedding)
  source    String   @default("STATIC") // STATIC | SYNC (HF) | LEARNED
  createdAt DateTime @default(now())

  @@unique([modelId, key])
  @@index([key])
}

// Performance RÉELLE mesurée après chaque exécution (boucle d'apprentissage
// du Model Router — Phase 7/8 : influence les sélections futures).
model ModelPerformance {
  id             String   @id @default(cuid())
  modelId        String
  model          AIModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  provider       String
  taskType       String // ANALYSIS | PLANNING | EXECUTION | VERIFICATION | LEARNING | CHAT | SUMMARIZATION | EMBEDDING | VISION
  success        Boolean
  qualityScore   Float? // score de l'évaluateur GEN3IA (0-1)
  executionMs    Int
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  costCredits    Float    @default(0)
  errorType      String? // code d'erreur normalisé
  contextType    String? // catégorie de contexte (document, code, conversation…)
  evaluatorScore Float? // score détaillé du Verification Engine
  humanScore     Float? // note humaine si retour utilisateur
  taskId         String?
  createdAt      DateTime @default(now())

  @@index([modelId, taskType, createdAt])
  @@index([provider, createdAt])
  @@index([taskType, createdAt])
}

// Décision de routage tracée (pourquoi CE modèle — audit + tableau de bord).
model ModelSelection {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  modelId      String
  model        AIModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  provider     String
  taskType     String
  score        Float
  confidence   Float // 0-1
  reason       String // justification lisible
  alternatives String? // JSON : [{model, provider, score, reason}]
  costEstimate Float    @default(0) // crédits estimés
  actualCost   Float? // crédits réellement consommés
  requestId    String? // corrélation des traces
  taskId       String?
  agentId      String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([modelId, createdAt])
  @@index([taskId])
}

// Santé des providers (circuit breaker persistant + latence glissante).
model ProviderHealth {
  id                   String   @id @default(cuid())
  provider             String   @unique
  status               String   @default("UP") // UP | DEGRADED | DOWN
  consecutiveFailures  Int      @default(0)
  consecutiveSuccesses Int      @default(0)
  avgLatencyMs         Float    @default(0)
  lastError            String?
  lastChecked          DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status])
}

// Endpoints d'inférence dédiés HF (gérés via l'API endpoints.huggingface.cloud).
model InferenceEndpoint {
  id              String   @id @default(cuid())
  name            String   @unique // nom HF unique de l'endpoint
  modelId         String // repo HF servi par l'endpoint
  status          String   @default("PENDING") // PENDING | RUNNING | SCALED_TO_ZERO | PAUSED | FAILED | DELETED
  hardware        String   @default("cpu-basic") // cpu-basic | cpu-upgrade | gpu-t4 …
  accelerator     String? // gpu | cpu
  vendor          String? // aws | gcp | aws-eu…
  region          String? // us-east-1…
  minReplicas     Int      @default(0)
  maxReplicas     Int      @default(1)
  currentReplicas Int      @default(0)
  url             String? // URL d'inférence une fois déployé
  type            String   @default("protected") // public | protected | private
  tokensUsed      Int      @default(0)
  lastSync        DateTime @default(now())
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}

// Jobs Hugging Face longs (préprocessing, embeddings batch, fine-tuning,
// batch inference, génération massive) — checkpointés dans le HF Bucket.
model HFJob {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           String // preprocessing | embeddings-batch | dataset-generation | evaluation | fine-tuning | conversion | batch-inference | media-processing
  status         String    @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED | CANCELLED
  queueJobId     String? // identifiant BullMQ
  hfRef          String? // référence HF (repo job / run)
  inputRef       String? // chemin Bucket des entrées
  outputRef      String? // chemin Bucket des sorties
  checkpointRef  String? // chemin Bucket du dernier checkpoint
  progress       Float     @default(0) // 0-1
  attempt        Int       @default(0)
  maxAttempts    Int       @default(3)
  timeoutMs      Int       @default(600000)
  idempotencyKey String?   @unique
  parameters     String? // JSON
  result         String? // JSON
  error          String?
  costCredits    Float     @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

// Objets stockés dans les Buckets HF (métadonnées seulement — les octets
// restent dans le Bucket, jamais dans PostgreSQL).
model StorageObject {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bucket      String // models | datasets | users | agents | knowledge | embeddings | generated | checkpoints | artifacts | logs | temporary
  path        String // chemin logique dans le bucket (ex: knowledge/report.pdf)
  repoId      String // repo HF réel (ex: gen3ia-knowledge)
  size        Int      @default(0) // octets
  contentType String?
  sha         String? // ETag/sha du blob HF
  etag        String?
  metadata    String? // JSON
  deleted     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([bucket, path, userId])
  @@index([userId, bucket])
  @@index([repoId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Agent {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  slug         String   @unique
  description  String?
  systemPrompt String?
  provider     String   @default("auto") // auto | zai | glm | openrouter | groq | openai | huggingface
  model        String   @default("auto")
  temperature  Float    @default(0.7)
  maxTokens    Int      @default(4096)
  status       String   @default("DRAFT") // DRAFT | PUBLISHED | PAUSED | ARCHIVED
  visibility   String   @default("PRIVATE") // PRIVATE | MARKETPLACE
  category     String?
  tags         String? // JSON : ["analyse", "rédaction"]
  config       String? // JSON : { tools, skills, guardrails, memory, rag, autonomy }
  stats        String? // JSON : { runs, success, failed, tokens, credits, avgLatencyMs }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks   Task[]
  reviews MarketplaceReview[]
  listing AgentListing?

  @@index([userId])
  @@index([status, visibility])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId    String?
  name       String
  prefix     String // 12 premiers caractères, affichables
  keyHash    String    @unique // SHA-256 du secret complet
  scopes     String    @default("chat,analyze,task") // CSV
  requests   Int       @default(0)
  revoked    Boolean   @default(false)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Machine à états d'une tâche :
// QUEUED -> ANALYZING -> PLANNING -> SIMULATING -> EXECUTING -> VERIFYING
//   -> LEARNING -> COMPLETED
// WAITING_FOR_HUMAN (depuis SIMULATING/EXECUTING, reprend vers l'état d'origine)
// FAILED / CANCELLED (terminal)
model Task {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId         String?
  agent           Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  prompt          String
  status          String    @default("QUEUED")
  analysis        String? // JSON : PromptAnalysis
  plans           String? // JSON : Plan[5]
  planScores      String? // JSON : scores d'évaluation
  selectedPlanId  String?
  executionLog    String? // JSON : journaux d'exécution
  verification    String? // JSON : rapport de vérification
  correctionLog   String? // JSON : historique des auto-corrections
  learning        String? // JSON : leçons extraites
  result          String? // JSON : { answer, evidence, artifacts, metrics }
  pendingApproval String? // JSON : approbation humaine en attente
  costCredits     Float     @default(0)
  tokensIn        Int       @default(0)
  tokensOut       Int       @default(0)
  attempts        Int       @default(0)
  totalRetries    Int       @default(0) // plafond global de retries (circuit breaker)
  version         Int       @default(0) // verrouillage optimiste des fusions JSON
  error           String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  steps     TaskStep[]
  artifacts TaskArtifact[]

  @@index([userId, createdAt])
  @@index([status])
}

model TaskStep {
  id         String    @id @default(cuid())
  taskId     String
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  phase      String // ANALYZING | PLANNING | SIMULATING | EXECUTING | CORRECTING | VERIFYING | LEARNING | DELIVERING
  stepIndex  Int       @default(0)
  title      String
  detail     String? // JSON : données propres à l'étape
  status     String    @default("PENDING") // PENDING | RUNNING | DONE | FAILED | SKIPPED | WAITING
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([taskId])
}

model Transaction {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String // TASK_EXECUTION | PLAN_GENERATION | AGENT_DEPLOY | TOPUP | SUBSCRIPTION | REFUND | BONUS | ADJUSTMENT
  amount       Float // positif = crédit, négatif = débit
  balanceAfter Float
  description  String
  refType      String?
  refId        String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model Payment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String   @default("chariow")
  checkoutId String? // identifiant de transaction Chariow
  plan       String?
  amount     Float
  currency   String   @default("XOF")
  credits    Float    @default(0)
  status     String   @default("PENDING") // PENDING | SUCCEEDED | FAILED
  raw        String? // JSON : charge utile du webhook
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Document {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId    String?
  title      String
  sourceType String   @default("TEXT") // TEXT | FILE | URL
  content    String
  chunks     String? // JSON : morceaux indexés pour le RAG
  size       Int      @default(0)
  createdAt  DateTime @default(now())

  embeddings Embedding[]

  @@index([userId])
}

model Memory {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId    String?
  layer      String // SHORT_TERM | LONG_TERM | TASK | USER | AGENT
  content    String
  importance Float     @default(0.5)
  metadata   String? // JSON
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, layer])
}

model Skill {
  id          String   @id @default(cuid())
  userId      String? // null = compétence intégrée
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String   @unique
  name        String
  description String
  category    String   @default("GENERAL")
  definition  String? // JSON : { instructions, tools, examples }
  isPublic    Boolean  @default(false)
  installs    Int      @default(0)
  createdAt   DateTime @default(now())
}

model Tool {
  id          String   @id @default(cuid())
  userId      String? // null = catalogue intégré
  key         String   @unique
  name        String
  description String
  category    String   @default("GENERAL")
  parameters  String? // JSON : schéma des paramètres
  isBuiltIn   Boolean  @default(false)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model MarketplaceReview {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([agentId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  detail     String? // JSON
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// ============================================================
// Améliorations v3.1 — vecteurs, cache, télémétrie, config, artefacts
// ============================================================

model Embedding {
  id         String   @id @default(cuid())
  userId     String
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  chunkText  String
  embedding  String // JSON : number[]
  dim        Int
  norm       Float // norme L2 précalculée (accélère la similarité cosinus)
  model      String // fournisseur d'embedding (openai/..., local/hash-256…)
  createdAt  DateTime @default(now())

  @@index([userId, documentId])
  @@index([userId, model])
}

model PlanCache {
  id             String   @id @default(cuid())
  userId         String
  promptHash     String // SHA-256 du prompt normalisé
  prompt         String
  embedding      String? // JSON : number[] — recherche sémantique
  plans          String // JSON : Plan[]
  planScores     String // JSON : évaluation complète
  selectedPlanId String
  hitCount       Int      @default(0)
  lastUsedAt     DateTime @default(now())
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([userId, promptHash])
  @@index([userId, lastUsedAt])
}

model EngineRun {
  id         String   @id @default(cuid())
  engine     String // PROMPT_ANALYSIS | PLANNER | EVALUATOR | EXECUTOR | VERIFICATION | SELF_CORRECTION | LEARNING | ORCHESTRATOR
  taskId     String?
  userId     String?
  phase      String?
  ok         Boolean
  errorCode  String?
  durationMs Int
  attempts   Int      @default(1)
  tokensIn   Int      @default(0)
  tokensOut  Int      @default(0)
  credits    Float    @default(0)
  detail     String? // JSON : contexte (outils utilisés, stratégie de plan…)
  createdAt  DateTime @default(now())

  @@index([engine, createdAt])
  @@index([taskId])
}

// Connexions d'applications externes via Composio (1000+ apps réelles).
// Les jetons OAuth vivent CHEZ Composio — GEN3IA ne stocke que l'identifiant

// Configuration système éditable depuis l'interface admin (KV JSON).
model SystemConfig {
  key       String   @id
  value     String // JSON
  updatedAt DateTime @updatedAt
}

model TaskArtifact {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind      String // EVIDENCE | STEP_OUTPUT | EXECUTION_RESULT | PHASE_OUTPUT
  phase     String?
  stepIndex Int?
  payload   String // gzip + base64
  bytes     Int // taille décompressée
  createdAt DateTime @default(now())

  @@index([taskId])
}

// ─────────────────────────────────────────────────────────────
// CONNECTORS — comptes connectés (moteur local, architecture
// adaptée de Composio — MIT, Sampark Inc.). Secrets chiffrés
// AES-256-GCM : jamais de token en clair en base.
// ─────────────────────────────────────────────────────────────
model ConnectedAccount {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  appSlug       String // github | slack | gmail | calendar | notion | …
  status        String    @default("INITIALIZING") // INITIALIZING | INITIATED | ACTIVE | FAILED | EXPIRED | REVOKED
  authScheme    String // OAUTH2 | OAUTH1 | API_KEY | BEARER_TOKEN | BASIC | NO_AUTH
  encryptedData String // JSON ConnectionData chiffré AES-256-GCM (access/refresh token, secrets)
  meta          String? // JSON non sensible : { scopes, accountHint, tokenExpiresAt }
  lastError     String?
  lastRefreshAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, appSlug])
  @@index([userId])
  @@index([appSlug, status])
}

// Demande de connexion en cours : state anti-CSRF + verifier PKCE
// (chiffrés), sert de handshake entre initiate et callback OAuth.
model ConnectionRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appSlug     String
  status      String   @default("PENDING") // PENDING | COMPLETED | FAILED | EXPIRED
  redirectUri String? // URL UI de retour après connexion
  state       String   @unique // HMAC-signé, à usage unique
  verifierEnc String? // code_verifier PKCE chiffré (OAuth2 avec PKCE)
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([userId])
  @@index([appSlug, status])
}

// ============================================================
// v3.3 — Multi-Agents & Swarm
// ============================================================

model SwarmSession {
  id          String   @id @default(cuid())
  taskId      String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy    String   @default("HIERARCHICAL")
  status      String   @default("RUNNING")
  prompt      String
  plan        String?
  result      String?
  tokensIn    Int      @default(0)
  tokensOut   Int      @default(0)
  costCredits Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subTasks       SubTask[]
  sharedMemories SharedMemory[]
  messages       SwarmMessage[]

  @@index([userId, createdAt])
  @@index([status])
}

model SubTask {
  id            String       @id @default(cuid())
  sessionId     String
  session       SwarmSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title         String
  description   String
  assignedAgent String
  status        String       @default("PENDING")
  dependencies  String?
  input         String?
  result        String?
  error         String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([sessionId])
}

model SharedMemory {
  id        String        @id @default(cuid())
  sessionId String?
  session   SwarmSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String?
  key       String
  value     String
  author    String
  namespace String        @default("default")
  version   Int           @default(1)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([sessionId, namespace, key])
}

model SwarmMessage {
  id        String       @id @default(cuid())
  sessionId String
  session   SwarmSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  channel   String
  senderId  String
  content   String
  payload   String?
  createdAt DateTime     @default(now())

  @@index([sessionId, channel])
}

// ============================================================
// v3.3 — Exécution autonome avancée
// ============================================================

model TaskPriority {
  id        String   @id @default(cuid())
  taskId    String   @unique
  cost      Float    @default(0.33)
  speed     Float    @default(0.33)
  accuracy  Float    @default(0.34)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExplorationRun {
  id           String   @id @default(cuid())
  taskId       String
  variantCount Int
  winnerPlanId String
  results      String
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([taskId])
}

// ============================================================
// v3.3 — Apprentissage & personnalisation
// ============================================================

model FineTuneJob {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  status      String    @default("QUEUED") // QUEUED | RUNNING | COMPLETED | FAILED | CANCELLED
  datasetPath String?
  datasetSize Int       @default(0)
  baseModel   String
  engine      String    @default("unsloth") // unsloth | axolotl
  config      String? // JSON
  metrics     String? // JSON : loss, eval_loss, epochs
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
}

model AutoSkill {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern     String // pattern détecté
  code        String // code généré
  language    String   @default("typescript")
  status      String   @default("DRAFT") // DRAFT | VALIDATED | PUBLISHED | REJECTED
  usageCount  Int      @default(0)
  successRate Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model UserProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  responseStyle    String   @default("balanced") // concise | balanced | detailed
  tone             String   @default("professional") // professional | casual | formal
  language         String   @default("fr")
  detailLevel      Float    @default(0.5) // 0-1
  preferences      String? // JSON
  interactionCount Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ============================================================
// v3.3 — Gouvernance & sécurité
// ============================================================

model ImmutableAuditLog {
  id         String   @id @default(cuid())
  userId     String?
  prevHash   String? // hash de l'entrée précédente (chaîne)
  entryHash  String // HMAC-SHA256 du contenu
  action     String
  entityType String?
  entityId   String?
  detail     String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model AnomalyAlert {
  id          String   @id @default(cuid())
  userId      String?
  type        String // LOOP | COST_SPIKE | FAILURE_RATE | LATENCY
  severity    String   @default("WARNING") // INFO | WARNING | CRITICAL
  message     String
  metric      String?
  threshold   Float?
  actualValue Float?
  action      String   @default("ALERT") // ALERT | THROTTLE | BLOCK
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([resolved])
}

// ============================================================
// v3.3 — Observabilité & tracing
// ============================================================

model Trace {
  id         String   @id @default(cuid())
  traceId    String   @unique
  taskId     String?
  userId     String?
  rootSpanId String?
  status     String   @default("RUNNING")
  durationMs Int      @default(0)
  spans      Int      @default(0)
  createdAt  DateTime @default(now())

  spanList TraceSpan[]

  @@index([taskId])
  @@index([createdAt])
}

model TraceSpan {
  id           String   @id @default(cuid())
  traceId      String
  trace        Trace    @relation(fields: [traceId], references: [id], onDelete: Cascade)
  spanId       String
  parentSpanId String?
  name         String
  startTime    Float
  endTime      Float?
  durationMs   Int      @default(0)
  attributes   String? // JSON
  status       String   @default("UNSET") // OK | ERROR | UNSET
  events       String? // JSON
  createdAt    DateTime @default(now())

  @@index([traceId])
}

// ============================================================
// v3.3 — Batch
// ============================================================

model BatchTask {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String?
  status    String   @default("PENDING") // PENDING | RUNNING | COMPLETED | PARTIAL | FAILED
  total     Int      @default(0)
  completed Int      @default(0)
  failed    Int      @default(0)
  results   String? // JSON agrégé
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items BatchItem[]

  @@index([userId, createdAt])
}

model BatchItem {
  id        String    @id @default(cuid())
  batchId   String
  batch     BatchTask @relation(fields: [batchId], references: [id], onDelete: Cascade)
  taskId    String?
  prompt    String
  status    String    @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  result    String?
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([batchId])
}

// ============================================================
// v3.3 — Écosystème & partage
// ============================================================

model AgentListing {
  id          String   @id @default(cuid())
  agentId     String   @unique
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  price       Float    @default(0) // 0 = gratuit
  currency    String   @default("XOF")
  commission  Float    @default(0.1) // 10% par défaut
  description String?
  tags        String? // JSON
  downloads   Int      @default(0)
  purchases   Int      @default(0)
  revenue     Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Purchase {
  id            String   @id @default(cuid())
  buyerId       String
  sellerId      String
  agentId       String
  listingId     String
  amount        Float
  commission    Float
  payout        Float
  status        String   @default("PENDING") // PENDING | COMPLETED | REFUNDED
  forkedAgentId String? // agent cloné dans le compte de l'acheteur
  createdAt     DateTime @default(now())

  @@index([buyerId])
  @@index([sellerId])
}

model WebhookConfig {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  events    String // JSON : ["task.completed", "task.failed"]
  secret    String // pour signature HMAC
  agentId   String?
  taskId    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([userId])
}

model WebhookDelivery {
  id          String        @id @default(cuid())
  webhookId   String
  webhook     WebhookConfig @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event       String
  payload     String
  statusCode  Int?
  response    String?
  attempt     Int           @default(1)
  error       String? // message d'erreur réseau (livraison impossible)
  deliveredAt DateTime?
  createdAt   DateTime      @default(now())

  @@index([webhookId, createdAt])
}

model ExternalConnection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // postgresql | mysql | mongodb | salesforce | hubspot | notion | slack
  name      String
  config    String // JSON encrypté (host, port, database, credentials…)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type])
}

model WatchConfig {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         String // PRICE | WEBSITE | INDICATOR | CUSTOM
  target       String // URL ou identifiant
  schedule     String // expression CRON
  condition    String? // JSON : { operator: "lt", value: 100 }
  alertChannel String    @default("email") // email | slack | webhook
  alertTarget  String? // email/Slack channel/webhook URL
  lastValue    String?
  lastCheckAt  DateTime?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  executions WatchExecution[]

  @@index([userId, active])
}

model WatchExecution {
  id         String      @id @default(cuid())
  watchId    String
  watch      WatchConfig @relation(fields: [watchId], references: [id], onDelete: Cascade)
  value      String?
  triggered  Boolean     @default(false)
  alertSent  Boolean     @default(false)
  error      String?
  executedAt DateTime    @default(now())

  @@index([watchId, executedAt])
}

// ---------------------------------------------------------------------------
// v3.4 — Authentification OAuth (GitHub / Google) : registre des apps
// ---------------------------------------------------------------------------

// Identités OAuth rattachées à un compte utilisateur. Un utilisateur peut
// lier plusieurs fournisseurs ; la fusion se fait par e-mail vérifié.
model OAuthIdentity {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation("OAuthIdentities", fields: [userId], references: [id], onDelete: Cascade)
  provider          String // github | google
  providerAccountId String   @unique
  email             String?
  name              String?
  avatarUrl         String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// v3.4 — Registre des applications OAuth de la plateforme (modèle Composio)
// ---------------------------------------------------------------------------
// Pour chaque app du catalogue, l'opérateur de la plateforme enregistre les
// client_id/client_secret de SON application OAuth (créée chez le fournisseur).
// Les utilisateurs finaux n'ont alors qu'à cliquer « Connecter » : le flux
// OAuth utilise les identifiants de la plateforme, jamais les leurs.

model OAuthAppConfig {
  id           String   @id @default(cuid())
  appSlug      String   @unique // ex. github, slack, notion (catalogue)
  clientId     String
  clientSecret String // chiffré AES-256-GCM
  redirectUri  String?
  scopes       String? // surcharge des scopes par défaut (CSV)
  extraConfig  String? // JSON : endpoints spécifiques, PKCE, tenant…
  active       Boolean  @default(true)
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
}

// ---------------------------------------------------------------------------
// v3.4 — Mode live : sessions de partage d'écran temps réel (WebRTC P2P)
// ---------------------------------------------------------------------------

model LiveSession {
  id          String    @id @default(cuid())
  code        String    @unique // code court à partager
  hostId      String
  host        User      @relation("LiveHost", fields: [hostId], references: [id], onDelete: Cascade)
  taskId      String? // tâche liée (optionnel)
  title       String?
  status      String    @default("LIVE") // LIVE | ENDED
  viewerCount Int       @default(0)
  createdAt   DateTime  @default(now())
  endedAt     DateTime?
  updatedAt   DateTime  @updatedAt

  participants LiveParticipant[]
  signals      LiveSignal[]

  @@index([status, createdAt])
}

model LiveParticipant {
  id          String      @id @default(cuid())
  sessionId   String
  session     LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?       @relation("LiveParticipants", fields: [userId], references: [id], onDelete: SetNull)
  displayName String
  role        String      @default("VIEWER") // HOST | VIEWER
  lastSeenAt  DateTime    @default(now())
  joinedAt    DateTime    @default(now())
  leftAt      DateTime?

  signalsSent LiveSignal[] @relation("SignalFrom")

  @@unique([sessionId, userId])
  @@index([sessionId, lastSeenAt])
}

// Messages de signalisation WebRTC (SDP offers/answers, candidats ICE).
// Échangés via l'API et consommés par polling long-côté clients ; le flux
// média lui-même voyage en P2P chiffré (DTLS/SRTP), jamais via le serveur.
model LiveSignal {
  id         String          @id @default(cuid())
  sessionId  String
  session    LiveSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fromId     String
  from       LiveParticipant @relation("SignalFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId       String? // null = diffusion à tous les autres participants
  type       String // OFFER | ANSWER | ICE | BYE | CHAT
  payload    String // JSON (SDP, candidat ICE…)
  createdAt  DateTime        @default(now())
  consumedAt DateTime?

  @@index([sessionId, createdAt])
  @@index([toId, consumedAt])
}

// ============================================================
// Publicités (v3.5) — page /ads : annonces des utilisateurs,
// facturation dédiée (portefeuille publicitaire + recharges
// Chariow), campagnes et créas, comptes de plates publicitaires
// liés via les connecteurs OAuth (googleads, metaads, tiktok…).
// ============================================================

model AdWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Float    @default(0) // solde publicitaire en FCFA (XOF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions AdTransaction[]

  @@index([userId])
}

model AdTransaction {
  id           String   @id @default(cuid())
  walletId     String
  wallet       AdWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type         String // RECHARGE | SPEND | REFUND
  amount       Float // + recharge / remboursement, - dépense
  balanceAfter Float
  description  String
  paymentId    String? // recharge → Payment Chariow correspondante
  campaignId   String? // dépense → campagne concernée
  createdAt    DateTime @default(now())

  @@index([walletId, createdAt])
}

model AdCampaign {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  platform     String // googleads | metaads | tiktok | linkedin_ads | other
  objective    String    @default("TRAFFIC") // AWARENESS | TRAFFIC | CONVERSION | LEADS
  status       String    @default("DRAFT") // DRAFT | ACTIVE | PAUSED | COMPLETED
  budgetPerDay Float     @default(0) // budget journalier en FCFA (débité du portefeuille)
  totalSpent   Float     @default(0)
  targetUrl    String?
  startDate    DateTime?
  endDate      DateTime?
  lastChargeAt DateTime? // dernier règlement de budget (settlement paresseux)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  creatives AdCreative[]

  @@index([userId, createdAt])
  @@index([status])
}

model AdCreative {
  id         String     @id @default(cuid())
  campaignId String
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  headline   String
  body       String
  mediaUrl   String?
  cta        String?
  status     String     @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt  DateTime   @default(now())

  @@index([campaignId])
}

// ─── Méta-learning cross-agent (v3.6) ─────────────────────────
// Patrons d'échec/succès GÉNÉRALISÉS et ANONYMISÉS partagés entre
// agents et utilisateurs — accélère l'apprentissage global de la
// plateforme sans jamais exposer de contenu utilisateur.
model CrossAgentPattern {
  id            String   @id @default(cuid())
  patternHash   String   @unique // SHA-256 du patron généralisé (déduplication)
  pattern       String // leçon généralisée, extraite sans données utilisateur
  category      String   @default("FAILURE") // FAILURE | SUCCESS
  tags          String? // JSON : ["tool:code_runner", "phase:EXECUTING", "code:RETRY_BUDGET_EXCEEDED"]
  occurrences   Int      @default(1)
  distinctUsers Int      @default(1) // utilisateurs distincts ayant rencontré ce patron
  seenBy        String? // JSON : empreintes hachées d'utilisateurs (anonymisation)
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([category, lastSeenAt])
}

// ─── Abonnements SaaS (v3.6 — business) ────────────────────────
model Subscription {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planKey            String // starter | pro | business
  interval           String // monthly | yearly
  status             String    @default("ACTIVE") // ACTIVE | EXPIRED | CANCELLED
  price              Float // montant payé pour la période (FCFA)
  currency           String    @default("XOF")
  creditsPerPeriod   Int // crédits offerts à chaque période
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  lastGrantAt        DateTime?
  provider           String    @default("chariow") // TOUJOURS chariow (ADR-0007)
  providerRef        String? // référence checkout/session du paiement
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@index([status, currentPeriodEnd])
}
